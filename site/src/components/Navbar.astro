---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pathname = Astro.url.pathname;
const isCriterios = pathname.includes('/criterios');
const isVotacoes = pathname.includes('/votacao') || pathname.includes('/votacoes');
const isPresidente = pathname.includes('/presidente');
const isHome = !isCriterios && !isVotacoes && !isPresidente && (pathname === base || pathname === `${base}index.html` || pathname.endsWith('/'));
---
<header class="border-b border-slate-200 bg-white/90 backdrop-blur sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href={base} class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold text-base shadow-xs group-hover:bg-emerald-700 transition">
        FP
      </div>
      <div>
        <span class="font-bold text-slate-900 text-lg tracking-tight group-hover:text-emerald-700 transition">Ficha do Político</span>
      </div>
    </a>

    <nav class="flex items-center gap-2 sm:gap-4 text-sm font-medium">
      <a 
        href={base} 
        class={`px-2 sm:px-3 py-1.5 rounded-lg transition ${isHome ? 'text-emerald-700 font-semibold bg-emerald-50/70' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'}`}
      >
        Parlamentares
      </a>
      <a 
        href={`${base}presidente`} 
        class={`px-2 sm:px-3 py-1.5 rounded-lg transition ${isPresidente ? 'text-emerald-700 font-semibold bg-emerald-50/70' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'}`}
      >
        Presidência
      </a>
      <a 
        href={`${base}votacoes`} 
        class={`px-2 sm:px-3 py-1.5 rounded-lg transition ${isVotacoes ? 'text-emerald-700 font-semibold bg-emerald-50/70' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'}`}
      >
        Votações
      </a>
      <a 
        href={`${base}criterios`} 
        class={`px-2 sm:px-3 py-1.5 rounded-lg transition ${isCriterios ? 'text-emerald-700 font-semibold bg-emerald-50/70' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'}`}
      >
        Critérios & Fontes
      </a>
      <a 
        href="https://github.com/ficha-do-politico/fichadopolitico" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition text-slate-700 text-xs font-semibold shadow-2xs"
        aria-label="Repositório no GitHub"
      >
        <svg class="w-4 h-4 text-slate-800" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>
    </nav>
  </div>
</header>
