---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pathname = Astro.url.pathname;
const isGuia = pathname.includes('/guia');
const isCriterios = pathname.includes('/criterios');
const isVotacoes = pathname.includes('/votacao') || pathname.includes('/votacoes');
const isPresidente = pathname.includes('/presidente');
const isHome = !isGuia && !isCriterios && !isVotacoes && !isPresidente && (pathname === base || pathname === `${base}index.html` || pathname.endsWith('/'));
---
<header class="border-b border-slate-200 bg-white/90 backdrop-blur sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href={base} class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold text-base shadow-xs group-hover:bg-emerald-700 transition">
        FP
      </div>
      <div>
        <span class="font-bold text-slate-900 text-lg tracking-tight group-hover:text-emerald-700 transition">Ficha do Político</span>
      </div>
    </a>

    <!-- Navegação Desktop (telas médias e grandes) -->
    <nav class="hidden md:flex items-center gap-1.5 lg:gap-3 text-sm font-medium">
      <a 
        href={base} 
        class={`px-3 py-1.5 rounded-lg transition ${isHome ? 'text-emerald-700 font-semibold bg-emerald-50/80' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'}`}
      >
        Parlamentares
      </a>
      <a 
        href={`${base}presidente`} 
        class={`px-3 py-1.5 rounded-lg transition ${isPresidente ? 'text-emerald-700 font-semibold bg-emerald-50/80' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'}`}
      >
        Presidência
      </a>
      <a 
        href={`${base}votacoes`} 
        class={`px-3 py-1.5 rounded-lg transition ${isVotacoes ? 'text-emerald-700 font-semibold bg-emerald-50/80' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'}`}
      >
        Votações
      </a>
      <a 
        href={`${base}guia`} 
        class={`px-3 py-1.5 rounded-lg transition ${isGuia ? 'text-emerald-700 font-semibold bg-emerald-50/80' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'}`}
      >
        Guia de Cargos
      </a>
      <a 
        href={`${base}criterios`} 
        class={`px-3 py-1.5 rounded-lg transition ${isCriterios ? 'text-emerald-700 font-semibold bg-emerald-50/80' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'}`}
      >
        Critérios & Fontes
      </a>
    </nav>

    <!-- Botão Menu Mobile (telas pequenas) -->
    <button 
      id="mobileMenuBtn" 
      type="button" 
      class="md:hidden inline-flex items-center justify-center p-2 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition focus:outline-hidden focus:ring-2 focus:ring-emerald-500"
      aria-label="Abrir menu de navegação"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <!-- Ícone Menu (Hambúrguer) -->
      <svg id="menuOpenIcon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <!-- Ícone Fechar (X) -->
      <svg id="menuCloseIcon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Menu Dropdown Mobile -->
  <nav 
    id="mobileMenu" 
    class="hidden md:hidden border-t border-slate-200 bg-white/95 backdrop-blur px-4 pt-3 pb-5 space-y-1.5 shadow-lg transition-all duration-200"
    aria-label="Navegação mobile"
  >
    <a 
      href={base} 
      class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition ${isHome ? 'text-emerald-700 font-semibold bg-emerald-50 border border-emerald-200/60' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-100/80'}`}
    >
      <span>Parlamentares</span>
      {isHome && <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>}
    </a>
    <a 
      href={`${base}presidente`} 
      class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition ${isPresidente ? 'text-emerald-700 font-semibold bg-emerald-50 border border-emerald-200/60' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-100/80'}`}
    >
      <span>Presidência</span>
      {isPresidente && <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>}
    </a>
    <a 
      href={`${base}votacoes`} 
      class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition ${isVotacoes ? 'text-emerald-700 font-semibold bg-emerald-50 border border-emerald-200/60' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-100/80'}`}
    >
      <span>Votações</span>
      {isVotacoes && <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>}
    </a>
    <a 
      href={`${base}guia`} 
      class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition ${isGuia ? 'text-emerald-700 font-semibold bg-emerald-50 border border-emerald-200/60' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-100/80'}`}
    >
      <span>Guia de Cargos</span>
      {isGuia && <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>}
    </a>
    <a 
      href={`${base}criterios`} 
      class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition ${isCriterios ? 'text-emerald-700 font-semibold bg-emerald-50 border border-emerald-200/60' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-100/80'}`}
    >
      <span>Critérios & Fontes</span>
      {isCriterios && <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>}
    </a>
  </nav>

  <script is:inline>
    const btn = document.getElementById('mobileMenuBtn');
    const menu = document.getElementById('mobileMenu');
    const openIcon = document.getElementById('menuOpenIcon');
    const closeIcon = document.getElementById('menuCloseIcon');

    if (btn && menu) {
      btn.addEventListener('click', () => {
        const isOpen = !menu.classList.contains('hidden');
        if (isOpen) {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          if (openIcon) openIcon.classList.remove('hidden');
          if (closeIcon) closeIcon.classList.add('hidden');
        } else {
          menu.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          if (openIcon) openIcon.classList.add('hidden');
          if (closeIcon) closeIcon.classList.remove('hidden');
        }
      });

      // Fecha menu se clicar fora
      document.addEventListener('click', (e) => {
        if (!btn.contains(e.target) && !menu.contains(e.target) && !menu.classList.contains('hidden')) {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          if (openIcon) openIcon.classList.remove('hidden');
          if (closeIcon) closeIcon.classList.add('hidden');
        }
      });
    }
  </script>
</header>
