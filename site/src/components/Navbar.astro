---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<header class="border-b border-slate-200 bg-white/90 backdrop-blur sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href={base} class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold text-lg shadow-sm group-hover:bg-emerald-700 transition">
        FP
      </div>
      <div>
        <span class="font-bold text-slate-900 text-lg tracking-tight group-hover:text-emerald-700 transition">Ficha do Político</span>
        <span class="hidden sm:inline-block ml-2 text-xs font-medium px-2 py-0.5 bg-emerald-50 text-emerald-700 rounded-full border border-emerald-200">MVP v0</span>
      </div>
    </a>

    <nav class="flex items-center gap-4 text-sm font-medium text-slate-600">
      <a href={base} class="hover:text-emerald-600 transition">Deputados</a>
      <a href={`${base}criterios`} class="hover:text-emerald-600 transition">Critérios & Fontes</a>
      <a 
        href="https://github.com/ficha-do-politico/fichadopolitico" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition text-slate-700"
      >
        <span>GitHub</span>
        <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </nav>
  </div>
</header>
