---
import type { ParlamentarCardData } from '../types';

interface Props {
  parlamentar: ParlamentarCardData;
}

const { parlamentar } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const isSenado = parlamentar.casa === 'senado';
---

<a 
  href={parlamentar.href} 
  class="group flex items-center justify-between p-3.5 sm:p-4 rounded-xl bg-white border border-slate-200/90 hover:border-emerald-600 hover:shadow-sm transition-all duration-150"
  data-nome={parlamentar.nome_eleitoral.toLowerCase()}
  data-civil={parlamentar.nome_civil.toLowerCase()}
  data-partido={parlamentar.partido.toLowerCase()}
  data-uf={parlamentar.uf.toLowerCase()}
  data-casa={parlamentar.casa}
  data-candidato-2026={parlamentar.is_candidato_2026 ? "true" : "false"}
  data-reeleicao={parlamentar.is_reeleicao ? "true" : "false"}
>
  <!-- Foto e Identificação do Parlamentar -->
  <div class="flex items-center gap-3.5 min-w-0">
    <div class="relative w-11 h-11 sm:w-12 sm:h-12 rounded-full overflow-hidden bg-slate-100 border border-slate-200 shrink-0 group-hover:ring-2 group-hover:ring-emerald-600 transition">
      <img 
        src={parlamentar.url_foto} 
        alt={parlamentar.nome_eleitoral} 
        class="w-full h-full object-cover object-top"
        loading="lazy"
        onerror={`this.onerror=null; this.src='${base}avatar-placeholder.svg';`}
      />
    </div>

    <div class="min-w-0 flex-1">
      <h3 class="font-bold text-slate-900 text-sm sm:text-base truncate group-hover:text-emerald-700 transition leading-snug">
        {parlamentar.nome_eleitoral}
      </h3>
      
      <div class="flex flex-wrap items-center gap-1.5 mt-0.5">
        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
          {parlamentar.partido}
        </span>
        <span class="text-xs font-semibold text-slate-500">
          {parlamentar.uf}
        </span>
        <span class={`inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium border ${
          isSenado 
            ? 'bg-blue-50 text-blue-700 border-blue-200' 
            : 'bg-emerald-50 text-emerald-700 border-emerald-200'
        }`}>
          {isSenado ? 'Senado' : 'Câmara'}
        </span>
        {parlamentar.is_candidato_2026 && (
          <span class={`inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium border ${
            parlamentar.is_reeleicao
              ? 'bg-purple-50 text-purple-700 border-purple-200'
              : 'bg-amber-50 text-amber-800 border-amber-200'
          }`}>
            {parlamentar.is_reeleicao ? 'Reeleição' : `2026: ${parlamentar.cargo_2026}`}
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- Ação sutil -->
  <div class="shrink-0 pl-2 text-slate-300 group-hover:text-emerald-600 group-hover:translate-x-0.5 transition-all">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
