---
import type { DespesasCEAP } from '../types';

interface Props {
  despesas: DespesasCEAP;
  nomeEleitoral: string;
  casa?: 'camara' | 'senado';
}

const { despesas, nomeEleitoral, casa = 'camara' } = Astro.props;

if (!despesas) {
  return null;
}
---

<section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-6">
  <!-- Título e Totais -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z" />
        </svg>
        Gastos Parlamentares • Exercício 2026
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
        {casa === 'senado' ? 'Cota para o Exercício da Atividade Parlamentar dos Senadores (CEAPS)' : 'Cota para o Exercício da Atividade Parlamentar (CEAP)'}
      </h2>
      <p class="text-xs text-slate-500 mt-0.5">
        Despesas operacionais discricionárias registradas e reembolsadas {casa === 'senado' ? 'pelo Senado Federal' : 'pela Câmara dos Deputados'} para {nomeEleitoral} em 2026.
      </p>
    </div>

    <div class="sm:text-right">
      <span class="text-xs font-semibold text-slate-400 block uppercase">Total Gasto na Cota (2026)</span>
      <span class="text-2xl sm:text-3xl font-black text-slate-900">
        {despesas.total_formatado}
      </span>
      <span class="text-[11px] text-slate-400 block mt-0.5">
        {despesas.total_documentos} comprovantes fiscais processados
      </span>
    </div>
  </div>

  <!-- Breakdown por Categoria de Despesa -->
  {despesas.categorias && despesas.categorias.length > 0 && (
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700">
          Distribuição de Gastos por Categoria
        </h3>
        <span class="text-xs text-slate-400">
          {despesas.categorias.length} categorias de despesas
        </span>
      </div>

      <div class="grid grid-cols-1 gap-2.5">
        {despesas.categorias.map(cat => (
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200/80 flex flex-col gap-2">
            <div class="flex items-center justify-between text-xs sm:text-sm">
              <span class="font-medium text-slate-800">
                {cat.categoria}
              </span>
              <div class="flex items-center gap-2 font-mono">
                <span class="font-bold text-slate-900">
                  {cat.valor_formatado}
                </span>
                <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-200/80 text-slate-700">
                  {cat.percentual}%
                </span>
              </div>
            </div>
            <!-- Barra proporcional de gasto -->
            <div class="w-full bg-slate-200/60 rounded-full h-2 overflow-hidden">
              <div 
                class="bg-emerald-600 h-2 rounded-full transition-all duration-300"
                style={`width: ${Math.min(Math.max(cat.percentual, 1), 100)}%`}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Maiores Despesas Individuais com Link da Nota Fiscal -->
  {despesas.maiores_despesas && despesas.maiores_despesas.length > 0 && (
    <div class="space-y-3 pt-2">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700">
          Maiores Despesas Individuais com Nota Fiscal
        </h3>
        <span class="text-xs text-slate-400">
          Top 5 documentos fiscais em 2026
        </span>
      </div>

      <div class="overflow-x-auto border border-slate-200 rounded-xl">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold uppercase tracking-wider">
              <th class="p-3">Data</th>
              <th class="p-3">Fornecedor / Razão Social</th>
              <th class="p-3">Categoria</th>
              <th class="p-3 text-right">Valor Líquido</th>
              <th class="p-3 text-center">Nota Fiscal</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-normal">
            {despesas.maiores_despesas.map(item => (
              <tr class="hover:bg-slate-50/60 transition">
                <td class="p-3 whitespace-nowrap font-mono text-slate-500">
                  {item.data || '—'}
                </td>
                <td class="p-3">
                  <div class="font-medium text-slate-900 line-clamp-1 max-w-xs">
                    {item.fornecedor}
                  </div>
                  {item.cnpj_cpf && (
                    <div class="text-[11px] text-slate-400 font-mono">
                      CNPJ/CPF: {item.cnpj_cpf}
                    </div>
                  )}
                </td>
                <td class="p-3 text-slate-600 whitespace-nowrap">
                  {item.categoria}
                </td>
                <td class="p-3 text-right font-mono font-bold text-slate-900 whitespace-nowrap">
                  {item.valor_formatado}
                </td>
                <td class="p-3 text-center whitespace-nowrap">
                  {item.url_documento ? (
                    <a 
                      href={item.url_documento} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 hover:text-emerald-900 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 px-2 py-1 rounded-md transition"
                    >
                      <span>Ver NF oficial</span>
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  ) : (
                    <a 
                      href={despesas.fonte_oficial} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-600 hover:text-emerald-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 px-2 py-1 rounded-md transition"
                    >
                      <span>Transparência ↗</span>
                    </a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- Nota Metodológica e Rastreabilidade Mandatória (AGENTS.md §3.1) -->
  <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600 space-y-2">
    <div class="flex items-center justify-between gap-2">
      <div class="font-semibold text-slate-800 flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Entenda a {casa === 'senado' ? 'Cota Parlamentar do Senado (CEAPS)' : 'Cota Parlamentar (CEAP)'}
      </div>
      <a 
        href={despesas.fonte_oficial} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-emerald-700 hover:text-emerald-900 font-medium underline inline-flex items-center gap-1"
      >
        <span>Página de transparência oficial ↗</span>
      </a>
    </div>
    <p class="leading-relaxed">
      A <strong>{casa === 'senado' ? 'Cota para o Exercício da Atividade Parlamentar dos Senadores (CEAPS)' : 'Cota para o Exercício da Atividade Parlamentar (CEAP)'}</strong> é uma verba mensal destinada a cobrir despesas estritamente operacionais ligadas ao mandato (como passagens, locação de escritórios e veículos, consultorias e alimentação). Ela <strong>não inclui o subsídio (salário)</strong> dos parlamentares nem a contratação de assessores e secretários de gabinete. Todos os dados são obtidos diretamente dos portais oficiais de Dados Abertos e Transparência {casa === 'senado' ? 'do Senado Federal' : 'da Câmara dos Deputados'}.
    </p>
  </div>
</section>
