---
interface Props {
  deputado: {
    id: number;
    nome_eleitoral: string;
    nome_civil: string;
    partido: string;
    uf: string;
    url_foto: string;
    votos: Record<string, string>;
  };
}

const { deputado } = Astro.props;
---

<a 
  href={`/deputado/${deputado.id}`} 
  class="group relative flex items-center gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-emerald-500/50 hover:shadow-md transition-all duration-200"
  data-nome={deputado.nome_eleitoral.toLowerCase()}
  data-civil={deputado.nome_civil.toLowerCase()}
  data-partido={deputado.partido.toLowerCase()}
  data-uf={deputado.uf.toLowerCase()}
>
  <div class="relative w-14 h-14 rounded-full overflow-hidden bg-slate-100 border border-slate-200 flex-shrink-0 group-hover:ring-2 group-hover:ring-emerald-500 transition">
    <img 
      src={deputado.url_foto} 
      alt={deputado.nome_eleitoral} 
      class="w-full h-full object-cover object-top"
      loading="lazy"
      onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'%2394a3b8\'><path d=\'M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\'/></svg>';"
    />
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2">
      <h3 class="font-semibold text-slate-900 truncate group-hover:text-emerald-700 transition">
        {deputado.nome_eleitoral}
      </h3>
    </div>
    
    <div class="flex items-center gap-2 mt-1">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
        {deputado.partido}
      </span>
      <span class="text-xs font-medium text-slate-500">
        {deputado.uf}
      </span>
    </div>
  </div>

  <div class="text-slate-400 group-hover:text-emerald-600 group-hover:translate-x-0.5 transition flex-shrink-0">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
