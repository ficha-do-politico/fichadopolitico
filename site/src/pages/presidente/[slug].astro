---
import Layout from '../../layouts/Layout.astro';
import presidenciaData from '../../data/presidencia.json';
import type { CandidatoPresidencia } from '../../types';

export async function getStaticPaths() {
  const candidatos = presidenciaData as CandidatoPresidencia[];
  return candidatos.map(c => ({
    params: { slug: c.id },
    props: { candidato: c },
  }));
}

interface Props {
  candidato: CandidatoPresidencia;
}

const { candidato } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const fotoSrc = candidato.fotoUrl 
  ? (candidato.fotoUrl.startsWith('http') ? candidato.fotoUrl : `${base}${candidato.fotoUrl.replace(/^\//, '')}`)
  : `${base}avatar-placeholder.svg`;

const historico = candidato.historicoPatrimonial;
const ultimoPleito = historico[historico.length - 1];
const primeiroPleito = historico[0];

// Formatação abreviada de valores para referências dos eixos
function formatarValorAbreviado(val: number): string {
  if (val >= 1_000_000_000) {
    return `R$ ${(val / 1_000_000_000).toLocaleString('pt-BR', { maximumFractionDigits: 1 })} bi`;
  }
  if (val >= 1_000_000) {
    return `R$ ${(val / 1_000_000).toLocaleString('pt-BR', { maximumFractionDigits: 1 })} mi`;
  }
  if (val >= 1_000) {
    return `R$ ${(val / 1_000).toLocaleString('pt-BR', { maximumFractionDigits: 0 })} mil`;
  }
  return `R$ ${val.toLocaleString('pt-BR')}`;
}

// Cálculo para alturas e coordenadas do gráfico de evolução patrimonial
const valores = historico.map(h => h.totalDeclarado);
const valorMaximo = Math.max(...valores, 1);
const numPontos = historico.length;
const temMultiplasEleicoes = numPontos > 1;

// Variação acumulada no período inteiro
const variacaoTotalValor = temMultiplasEleicoes && primeiroPleito && ultimoPleito
  ? ultimoPleito.totalDeclarado - primeiroPleito.totalDeclarado
  : 0;
const variacaoTotalPct = temMultiplasEleicoes && primeiroPleito && primeiroPleito.totalDeclarado > 0
  ? `${variacaoTotalValor >= 0 ? '+' : ''}${((variacaoTotalValor / primeiroPleito.totalDeclarado) * 100).toFixed(1)}%`
  : null;
const variacaoTotalPositiva = variacaoTotalValor >= 0;

// Dimensões do canvas SVG responsivo
const chartWidth = Math.max(680, numPontos * 135);
const chartHeight = 290;
const padLeft = 85;
const padRight = 65;
const padTop = 50;
const padBottom = 65;
const plotWidth = chartWidth - padLeft - padRight;
const plotHeight = chartHeight - padTop - padBottom;

const yRefTopo = padTop;
const yRefMeio = padTop + plotHeight / 2;
const yRefBase = padTop + plotHeight;

const labelTopo = formatarValorAbreviado(valorMaximo);
const labelMeio = formatarValorAbreviado(valorMaximo / 2);
const labelBase = 'R$ 0';

// Cálculo das coordenadas de cada ponto e métricas de variação
const pontos = historico.map((h, i) => {
  const x = numPontos === 1
    ? chartWidth / 2
    : padLeft + (i / (numPontos - 1)) * plotWidth;
  const ratio = valorMaximo > 0 ? h.totalDeclarado / valorMaximo : 0;
  const y = yRefBase - (ratio * plotHeight);

  let diffValor = 0;
  let diffPctTexto: string | null = null;
  let diffPositiva = true;
  let saltoAnos = 0;
  let isSaltoLongo = false;

  if (i > 0) {
    const anterior = historico[i - 1];
    diffValor = h.totalDeclarado - anterior.totalDeclarado;
    saltoAnos = h.ano - anterior.ano;
    isSaltoLongo = saltoAnos > 4;
    diffPositiva = diffValor >= 0;
    if (anterior.totalDeclarado > 0) {
      const pct = (diffValor / anterior.totalDeclarado) * 100;
      const sinal = diffValor >= 0 ? '+' : '';
      diffPctTexto = `${sinal}${pct.toFixed(1)}%`;
    } else if (diffValor > 0) {
      diffPctTexto = '+100%';
    }
  }

  return {
    ...h,
    x,
    y,
    ratio,
    diffValor,
    diffPctTexto,
    diffPositiva,
    saltoAnos,
    isSaltoLongo,
  };
});

// Segmentos entre pontos adjacentes
const segmentos = [];
for (let i = 1; i < pontos.length; i++) {
  const p1 = pontos[i - 1];
  const p2 = pontos[i];
  segmentos.push({
    x1: p1.x,
    y1: p1.y,
    x2: p2.x,
    y2: p2.y,
    isSaltoLongo: p2.isSaltoLongo,
    saltoAnos: p2.saltoAnos,
    diffPctTexto: p2.diffPctTexto,
    diffPositiva: p2.diffPositiva,
    midX: (p1.x + p2.x) / 2,
    midY: (p1.y + p2.y) / 2,
  });
}

// Path de área sombreada sob a curva
const areaPathD = pontos.length > 1
  ? `M ${pontos[0].x} ${yRefBase} L ` +
    pontos.map(p => `${p.x} ${p.y}`).join(' L ') +
    ` L ${pontos[pontos.length - 1].x} ${yRefBase} Z`
  : '';

const pageTitle = `${candidato.nomeUrna} — Evolução Patrimonial`;
const pageDescription = `Confira a evolução patrimonial oficial de ${candidato.nomeUrna} (${candidato.partido}) ao longo de ${historico.length} eleições registradas no Tribunal Superior Eleitoral (TSE).`;
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image={fotoSrc}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 space-y-8">
    <!-- Navegação / Voltar -->
    <div>
      <a 
        href={`${base}presidente`} 
        class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-emerald-700 transition"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Voltar para todos os candidatos presidenciais
      </a>
    </div>

    <!-- Header do Candidato -->
    <header class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs flex flex-col sm:flex-row items-center sm:items-start gap-6">
      <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden bg-slate-100 border-2 border-slate-200 shadow-inner flex-shrink-0">
        <img 
          src={fotoSrc} 
          alt={candidato.nomeUrna} 
          class="w-full h-full object-cover object-top"
          onerror={`this.onerror=null; this.src='${base}avatar-placeholder.svg';`}
        />
      </div>

      <div class="text-center sm:text-left flex-1 space-y-3">
        <div class="space-y-1">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
              {candidato.nomeUrna}
            </h1>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-800 border border-slate-200">
              {candidato.partido}
            </span>
            <span class="text-xs font-bold text-slate-500">
              Nº {candidato.numeroUrna}
            </span>
            {candidato.situacaoCandidatura === 'Eleito' && (
              <span class="px-2 py-0.5 text-xs font-bold bg-emerald-100 text-emerald-800 rounded-full">
                Eleito
              </span>
            )}
          </div>
          <p class="text-sm text-slate-500">
            {candidato.nomeCivil} • {candidato.partidoNome}
          </p>
          {candidato.vice && (
            <p class="text-xs text-slate-500">
              Chapa com: <strong class="text-slate-700">{candidato.vice.nomeUrna} ({candidato.vice.partido})</strong>
            </p>
          )}
        </div>

        <div class="pt-2 flex flex-wrap items-center justify-center sm:justify-start gap-3 text-xs">
          <a 
            href={candidato.tsePerfilUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold transition"
          >
            <span>Ver perfil no TSE DivulgaCand</span>
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          {candidato.fotoFonteOficial && (
            <span class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-600 text-2xs" title="Fonte oficial da foto">
              <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Foto: {candidato.fotoFonteOficial}
            </span>
          )}
        </div>
      </div>
    </header>

    <!-- Resumo Patrimonial (KPIs) -->
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-2xs">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">
          Último Declarado ({ultimoPleito?.ano})
        </span>
        <div class="text-xl sm:text-2xl font-black text-slate-900 mt-1">
          {ultimoPleito?.totalFormatado || 'R$ 0,00'}
        </div>
        <p class="text-xs text-slate-500 mt-0.5">
          Concorrendo a {ultimoPleito?.cargoDisputado}
        </p>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-2xs">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">
          Primeiro Registro ({primeiroPleito?.ano})
        </span>
        <div class="text-xl sm:text-2xl font-black text-slate-900 mt-1">
          {primeiroPleito?.totalFormatado || 'R$ 0,00'}
        </div>
        <p class="text-xs text-slate-500 mt-0.5">
          Concorrendo a {primeiroPleito?.cargoDisputado}
        </p>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-2xs">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">
          Eleições no Histórico
        </span>
        <div class="text-xl sm:text-2xl font-black text-emerald-700 mt-1">
          {historico.length} {historico.length === 1 ? 'pleito' : 'pleitos'}
        </div>
        <p class="text-xs text-slate-500 mt-0.5">
          {historico.length === 1 ? `Pleito de ${primeiroPleito?.ano}` : `Período ${primeiroPleito?.ano} a ${ultimoPleito?.ano}`}
        </p>
      </div>
    </section>

    <!-- Visualização Gráfica da Evolução Patrimonial -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-2xs space-y-6">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">
            Evolução Patrimonial Oficial (TSE)
          </h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Trajetória dos valores autodeclarados à Justiça Eleitoral a cada pleito disputado
          </p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md">
            Valores em R$ (nominal)
          </span>
          {variacaoTotalPct && (
            <span class={`text-xs font-bold px-2.5 py-1 rounded-md border ${
              variacaoTotalPositiva 
                ? 'bg-emerald-50 text-emerald-800 border-emerald-200' 
                : 'bg-rose-50 text-rose-800 border-rose-200'
            }`}>
              {variacaoTotalPositiva ? 'Crescimento acumulado:' : 'Variação acumulada:'} {variacaoTotalPct}
            </span>
          )}
        </div>
      </div>

      {temMultiplasEleicoes && (
        <div class="space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-slate-600 bg-slate-50/80 border border-slate-200/80 rounded-xl px-4 py-2.5">
            <div class="flex items-center gap-4 flex-wrap">
              <div class="inline-flex items-center gap-2">
                <span class="w-5 h-0.5 bg-emerald-600 rounded"></span>
                <span class="font-medium text-slate-700">Linha contínua: pleitos consecutivos</span>
              </div>
              <div class="inline-flex items-center gap-2">
                <span class="w-5 h-0 border-t-2 border-dashed border-emerald-600"></span>
                <span class="font-medium text-slate-700">Linha tracejada: hiato eleitoral (&gt; 4 anos)</span>
              </div>
            </div>
            <div class="text-2xs text-slate-400 font-medium">
              Eixo X: Ano do pleito • Eixo Y: Valor declarado
            </div>
          </div>

          <div class="overflow-x-auto pb-4 pt-1 -mx-2 px-2 sm:mx-0 sm:px-0">
            <div style={`min-width: ${chartWidth}px;`}>
              <svg 
                viewBox={`0 0 ${chartWidth} ${chartHeight}`} 
                class="w-full h-auto select-none overflow-visible"
                role="img" 
                aria-label={`Gráfico de evolução patrimonial oficial de ${candidato.nomeUrna}`}
              >
                <defs>
                  <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#059669" stop-opacity="0.22" />
                    <stop offset="100%" stop-color="#059669" stop-opacity="0.01" />
                  </linearGradient>
                </defs>

                <line x1={padLeft} y1={yRefTopo} x2={chartWidth - padRight + 15} y2={yRefTopo} stroke="#f1f5f9" stroke-dasharray="4,4" stroke-width="1.5" />
                <line x1={padLeft} y1={yRefMeio} x2={chartWidth - padRight + 15} y2={yRefMeio} stroke="#f1f5f9" stroke-dasharray="4,4" stroke-width="1.5" />
                <line x1={padLeft} y1={yRefBase} x2={chartWidth - padRight + 15} y2={yRefBase} stroke="#cbd5e1" stroke-width="1.5" />

                <text x={padLeft - 12} y={yRefTopo + 4} text-anchor="end" font-size="11" font-weight="600" fill="#94a3b8">{labelTopo}</text>
                <text x={padLeft - 12} y={yRefMeio + 4} text-anchor="end" font-size="11" font-weight="600" fill="#94a3b8">{labelMeio}</text>
                <text x={padLeft - 12} y={yRefBase + 4} text-anchor="end" font-size="11" font-weight="600" fill="#94a3b8">{labelBase}</text>

                {areaPathD && <path d={areaPathD} fill="url(#areaGrad)" />}

                {pontos.map(p => (
                  <line 
                    x1={p.x} 
                    y1={p.y} 
                    x2={p.x} 
                    y2={yRefBase} 
                    stroke="#cbd5e1" 
                    stroke-width="1.5" 
                    stroke-dasharray="2,3" 
                    opacity="0.65" 
                  />
                ))}

                {segmentos.map(s => (
                  <g>
                    <line 
                      x1={s.x1} 
                      y1={s.y1} 
                      x2={s.x2} 
                      y2={s.y2} 
                      stroke="#059669" 
                      stroke-width="3" 
                      stroke-linecap="round"
                      stroke-dasharray={s.isSaltoLongo ? "6,6" : undefined} 
                    />
                    {s.isSaltoLongo && (
                      <g>
                        <rect 
                          x={s.midX - 44} 
                          y={s.midY - 18} 
                          width="88" 
                          height="18" 
                          rx="9" 
                          fill="#ffffff" 
                          stroke="#cbd5e1" 
                          stroke-width="1" 
                        />
                        <text 
                          x={s.midX} 
                          y={s.midY - 5} 
                          text-anchor="middle" 
                          font-size="9" 
                          font-weight="700" 
                          fill="#64748b"
                        >
                          Hiato de {s.saltoAnos} anos
                        </text>
                      </g>
                    )}
                  </g>
                ))}

                {pontos.map(p => {
                  const hasBadge = !!p.diffPctTexto;
                  const yVal = p.y - (hasBadge ? 24 : 12);
                  const yBadge = p.y - 18;
                  const yBadgeText = p.y - 6;

                  return (
                    <g class="transition-transform group">
                      <circle cx={p.x} cy={p.y} r="8" fill="#10b981" opacity="0.25" />
                      
                      <circle 
                        cx={p.x} 
                        cy={p.y} 
                        r="5" 
                        fill="#ffffff" 
                        stroke="#047857" 
                        stroke-width="3" 
                      />

                      <text 
                        x={p.x} 
                        y={yVal} 
                        text-anchor="middle" 
                        font-size="12" 
                        font-weight="800" 
                        fill="#0f172a"
                      >
                        {p.totalFormatado}
                      </text>

                      {hasBadge && (
                        <g>
                          <rect 
                            x={p.x - 24} 
                            y={yBadge} 
                            width="48" 
                            height="15" 
                            rx="7.5" 
                            fill={p.diffPositiva ? '#ecfdf5' : '#fef2f2'} 
                            stroke={p.diffPositiva ? '#a7f3d0' : '#fecaca'} 
                            stroke-width="1" 
                          />
                          <text 
                            x={p.x} 
                            y={yBadgeText} 
                            text-anchor="middle" 
                            font-size="9.5" 
                            font-weight="700" 
                            fill={p.diffPositiva ? '#065f46' : '#991b1b'}
                          >
                            {p.diffPctTexto}
                          </text>
                        </g>
                      )}

                      <line x1={p.x} y1={yRefBase} x2={p.x} y2={yRefBase + 6} stroke="#94a3b8" stroke-width="1.5" />
                      <text 
                        x={p.x} 
                        y={yRefBase + 21} 
                        text-anchor="middle" 
                        font-size="13" 
                        font-weight="800" 
                        fill="#0f172a"
                      >
                        {p.ano}
                      </text>
                      <text 
                        x={p.x} 
                        y={yRefBase + 35} 
                        text-anchor="middle" 
                        font-size="10" 
                        font-weight="500" 
                        fill="#64748b"
                      >
                        {p.cargoDisputado}
                      </text>
                    </g>
                  );
                })}
              </svg>
            </div>
          </div>
        </div>
      )}

      {!temMultiplasEleicoes && (
        <div class="bg-slate-50 rounded-2xl border border-slate-200 p-6 sm:p-8 text-center space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-200/70 text-slate-700 text-xs font-semibold">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Primeiro Pleito Registrado no TSE
          </div>
          <div class="max-w-md mx-auto space-y-2">
            <div class="text-3xl font-black text-slate-900">
              {primeiroPleito?.totalFormatado || 'R$ 0,00'}
            </div>
            <p class="text-sm font-semibold text-slate-700">
              Eleição de {primeiroPleito?.ano} — {primeiroPleito?.cargoDisputado}
            </p>
            <p class="text-xs text-slate-500 leading-relaxed">
              Este candidato possui apenas um pleito autodeclarado na base oficial do TSE. A curva de evolução temporal (Eixo X = Ano, Eixo Y = Valor) será desenhada a partir de novos registros oficiais de candidatura.
            </p>
          </div>
        </div>
      )}

      <!-- Nota de Rastreabilidade -->
      <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
        <span>Fonte: Tribunal Superior Eleitoral (TSE / DivulgaCandContas)</span>
        <span class="text-emerald-700 font-semibold">100% Verificável</span>
      </div>
    </section>

    <!-- Lista Detalhada de Bens Declarados por Ano -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">
            Detalhamento dos Bens por Eleição
          </h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Clique em cada ano para visualizar os itens declarados oficialmente pelo candidato
          </p>
        </div>
      </div>

      <div class="space-y-3">
        {historico.slice().reverse().map((h, idx) => {
          const totalBens = h.bens.length;
          return (
            <details 
              class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-2xs group"
              open={idx === 0}
            >
              <summary class="flex items-center justify-between p-4 sm:p-5 cursor-pointer hover:bg-slate-50/80 transition list-none">
                <div class="flex items-center gap-3">
                  <span class="w-8 h-8 rounded-lg bg-slate-100 text-slate-900 font-bold text-sm flex items-center justify-center border border-slate-200">
                    {h.ano}
                  </span>
                  <div>
                    <h3 class="text-sm sm:text-base font-bold text-slate-900">
                      Eleição de {h.ano} — {h.cargoDisputado}
                    </h3>
                    <p class="text-xs text-slate-500">
                      {totalBens} {totalBens === 1 ? 'bem discriminado' : 'bens discriminados'}
                    </p>
                  </div>
                </div>

                <div class="flex items-center gap-4">
                  <span class="text-sm sm:text-base font-black text-slate-900">
                    {h.totalFormatado}
                  </span>
                  <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </summary>

              <div class="p-4 sm:p-5 border-t border-slate-100 bg-slate-50/50 space-y-4">
                {totalBens === 0 ? (
                  <p class="text-xs sm:text-sm text-slate-500 italic py-2">
                    Nenhum bem cadastrado ou declarado na prestação de contas à Justiça Eleitoral neste pleito.
                  </p>
                ) : (
                  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
                    <table class="w-full text-left text-xs sm:text-sm">
                      <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold">
                        <tr>
                          <th class="py-2.5 px-3">Tipo do Bem</th>
                          <th class="py-2.5 px-3">Descrição Oficial (TSE)</th>
                          <th class="py-2.5 px-3 text-right">Valor Declarado</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-slate-100">
                        {h.bens.map(bem => (
                          <tr class="hover:bg-slate-50/60 transition">
                            <td class="py-2.5 px-3 font-medium text-slate-900 whitespace-nowrap">
                              <span class="inline-block px-2 py-0.5 rounded text-2xs font-semibold bg-slate-100 text-slate-700">
                                {bem.tipo}
                              </span>
                            </td>
                            <td class="py-2.5 px-3 text-slate-600">
                              {bem.descricao}
                            </td>
                            <td class="py-2.5 px-3 text-right font-semibold text-slate-900 whitespace-nowrap">
                              {new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(bem.valor)}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                      <tfoot class="bg-slate-50 font-bold border-t border-slate-200">
                        <tr>
                          <td colspan="2" class="py-2.5 px-3 text-slate-800">
                            Total Declarado em {h.ano}
                          </td>
                          <td class="py-2.5 px-3 text-right text-emerald-800">
                            {h.totalFormatado}
                          </td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                )}

                <div class="flex justify-end pt-1">
                  <a 
                    href={h.tseUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700 hover:text-emerald-800 transition"
                  >
                    <span>Consultar registro oficial desta eleição no TSE</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              </div>
            </details>
          );
        })}
      </div>
    </section>

    <!-- Nota Metodológica de Rodapé -->
    <footer class="bg-white border border-slate-200 rounded-2xl p-6 text-xs text-slate-600 space-y-3">
      <h4 class="font-bold text-slate-900 text-sm flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        Metodologia & Compromisso com a Verdade
      </h4>
      <p class="leading-relaxed">
        <strong>1. Custo de Aquisição (Regra do IRPF):</strong> No Brasil, a declaração de bens à Justiça Eleitoral e à Receita Federal é autodeclaratória e segue a regra do custo histórico de aquisição. Isso significa que imóveis ou outros ativos não são atualizados automaticamente pela inflação ou pela cotação de mercado, exceto em caso de reformas ou benfeitorias documentalmente averbadas.
      </p>
      <p class="leading-relaxed">
        <strong>2. Apartidarismo e Isenção:</strong> O Ficha do Político não emite opiniões, notas ou juízos de valor sobre o crescimento ou redução de patrimônio de qualquer candidato. Exibimos os dados brutos oficiais tal como registrados no Tribunal Superior Eleitoral (TSE).
      </p>
      <p class="leading-relaxed">
        <strong>3. Verificabilidade:</strong> Todos os links apontam para páginas oficiais do domínio <code>tse.jus.br</code>.
      </p>
    </footer>
  </div>
</Layout>
