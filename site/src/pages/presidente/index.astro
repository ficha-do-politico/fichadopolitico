---
import Layout from '../../layouts/Layout.astro';
import presidenciaData from '../../data/presidencia.json';
import type { CandidatoPresidencia } from '../../types';

const candidatos = presidenciaData as CandidatoPresidencia[];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const totalCandidatos = candidatos.length;
const partidos = [...new Set(candidatos.map(c => c.partido))].sort();
---

<Layout 
  title="Presidência da República — Evolução Patrimonial"
  description="Histórico e evolução patrimonial oficial dos candidatos à Presidência da República com base em declarações prestadas ao Tribunal Superior Eleitoral (TSE)."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-emerald-50/60 via-slate-50 to-slate-50 pt-14 pb-10 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100/80 border border-emerald-300/60 text-emerald-800 text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        Dados Oficiais do TSE • DivulgaCandContas
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Presidência da República: Evolução Patrimonial
      </h1>

      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Consulte a trajetória de bens declarados à Justiça Eleitoral ao longo de todos os pleitos disputados pelos <strong class="text-slate-900">{totalCandidatos} candidatos</strong>, com links diretos para os registros públicos originais.
      </p>

      <!-- Nota Metodológica de Transparência -->
      <div class="mt-6 max-w-3xl mx-auto text-left bg-white border border-slate-200 rounded-xl p-4 shadow-2xs text-xs sm:text-sm text-slate-600 space-y-1.5">
        <div class="flex items-center gap-2 font-semibold text-slate-800">
          <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Nota metodológica oficial sobre declarações de bens no TSE</span>
        </div>
        <p class="leading-relaxed">
          Conforme a legislação eleitoral e normas da Receita Federal, os bens informados ao TSE reproduzem a Declaração de Imposto de Renda (IRPF) pelo <strong>custo histórico de aquisição</strong>, e não pela cotação de mercado atualizada. O Ficha do Político exibe exclusivamente os valores brutos oficiais informados pelo próprio candidato.
        </p>
      </div>

      <!-- Barra de Busca -->
      <div class="pt-4 max-w-xl mx-auto">
        <div class="relative shadow-sm rounded-2xl">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Buscar por nome do candidato ou partido (ex: Lula, Bolsonaro, Ciro, PL)..."
            autocomplete="off"
            class="w-full pl-11 pr-10 py-3.5 text-sm sm:text-base rounded-2xl border border-slate-300 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition outline-none bg-white text-slate-900 placeholder:text-slate-400"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Lista de Candidatos -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex items-center justify-between pb-6 border-b border-slate-200">
      <h2 class="text-lg font-bold text-slate-900">
        Candidatos Registrados (<span id="countDisplay">{totalCandidatos}</span>)
      </h2>
      <div class="text-xs text-slate-500">
        Clique para ver a evolução e lista completa de bens
      </div>
    </div>

    <div id="candidatosGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-6">
      {candidatos.map(cand => {
        const historico = cand.historicoPatrimonial;
        const ultimoPleito = historico[historico.length - 1];
        const primeiroPleito = historico[0];
        const totalEleicoes = historico.length;
        const fotoSrc = cand.fotoUrl 
          ? (cand.fotoUrl.startsWith('http') ? cand.fotoUrl : `${base}${cand.fotoUrl.replace(/^\//, '')}`)
          : `${base}avatar-placeholder.svg`;

        return (
          <a 
            href={`${base}presidente/${cand.id}`}
            class="candidato-card bg-white rounded-2xl border border-slate-200 hover:border-emerald-500/60 p-5 shadow-xs hover:shadow-md transition group flex flex-col justify-between"
            data-nome={cand.nomeUrna.toLowerCase()}
            data-civil={cand.nomeCivil.toLowerCase()}
            data-partido={cand.partido.toLowerCase()}
          >
            <div class="space-y-4">
              <!-- Topo: Foto e Identificação -->
              <div class="flex items-center gap-3.5">
                <div class="w-16 h-16 rounded-xl overflow-hidden bg-slate-100 border border-slate-200 flex-shrink-0 relative shadow-2xs">
                  <img 
                    src={fotoSrc} 
                    alt={cand.nomeUrna}
                    class="w-full h-full object-cover object-top"
                    onerror={`this.onerror=null; this.src='${base}avatar-placeholder.svg';`}
                    loading="lazy"
                  />
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-slate-100 text-slate-800 border border-slate-200">
                      {cand.partido}
                    </span>
                    <span class="text-xs font-bold text-slate-500">
                      Nº {cand.numeroUrna}
                    </span>
                    {cand.situacaoCandidatura === 'Eleito' && (
                      <span class="px-1.5 py-0.5 text-2xs font-bold bg-emerald-100 text-emerald-800 rounded">
                        Eleito
                      </span>
                    )}
                  </div>
                  <h3 class="text-lg font-bold text-slate-900 group-hover:text-emerald-700 transition truncate mt-0.5">
                    {cand.nomeUrna}
                  </h3>
                  <p class="text-xs text-slate-500 truncate" title={cand.nomeCivil}>
                    {cand.nomeCivil}
                  </p>
                </div>
              </div>

              <!-- Resumo do Patrimônio -->
              <div class="bg-slate-50 rounded-xl p-3 border border-slate-100 space-y-1">
                <div class="text-2xs font-semibold uppercase tracking-wider text-slate-500">
                  Patrimônio Mais Recente ({ultimoPleito?.ano})
                </div>
                <div class="text-xl font-black text-slate-900">
                  {ultimoPleito?.totalFormatado || 'R$ 0,00'}
                </div>
                <div class="text-xs text-slate-500 flex items-center justify-between pt-1">
                  <span>{totalEleicoes} {totalEleicoes === 1 ? 'pleito registrado' : 'pleitos registrados'}</span>
                  <span>{primeiroPleito?.ano} → {ultimoPleito?.ano}</span>
                </div>
              </div>
            </div>

            <!-- Rodapé do Card -->
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-emerald-700 group-hover:translate-x-0.5 transition">
              <span>Ver evolução e lista de bens</span>
              <span>→</span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Estado Vazio da Busca -->
    <div id="noResults" class="hidden text-center py-12 space-y-3">
      <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="text-base font-semibold text-slate-700">Nenhum candidato presidencial encontrado</p>
      <p class="text-sm text-slate-500">Verifique os termos digitados e tente novamente.</p>
    </div>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const cards = document.querySelectorAll('.candidato-card') as NodeListOf<HTMLElement>;
  const noResults = document.getElementById('noResults');
  const countDisplay = document.getElementById('countDisplay');

  function filterCandidates() {
    if (!searchInput) return;
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach(card => {
      const nome = card.dataset.nome || '';
      const civil = card.dataset.civil || '';
      const partido = card.dataset.partido || '';

      const matches = !query || nome.includes(query) || civil.includes(query) || partido.includes(query);

      if (matches) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (countDisplay) {
      countDisplay.textContent = String(visibleCount);
    }

    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  }

  searchInput?.addEventListener('input', filterCandidates);
</script>
