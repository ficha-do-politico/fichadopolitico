                <span class="text-xs text-slate-500">Chefe da administração municipal e gestor do orçamento público local</span>
              </div>
            </div>
            <a 
              href="https://www.planalto.gov.br/ccivil_03/constituicao/constituicao.htm#art29" 
              target="_blank" 
