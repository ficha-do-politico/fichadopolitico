<script>
  // Filtro de Situações e Demandas
  const inputFiltro = document.getElementById('filtro-problemas') as HTMLInputElement | null;
  const itens = document.querySelectorAll<HTMLElement>('.item-problema');
  const msgSemResultados = document.getElementById('sem-resultados');

  if (inputFiltro) {
    inputFiltro.addEventListener('input', () => {
      const termo = inputFiltro.value.toLowerCase().trim();
      let visiveis = 0;

      itens.forEach(item => {
        const tags = (item.getAttribute('data-tags') || '').toLowerCase();
        const texto = item.textContent?.toLowerCase() || '';

        if (!termo || tags.includes(termo) || texto.includes(termo)) {
          item.style.display = '';
          visiveis++;
        } else {
          item.style.display = 'none';
        }
      });

      if (msgSemResultados) {
        if (visiveis === 0) {
          msgSemResultados.classList.remove('hidden');
        } else {
          msgSemResultados.classList.add('hidden');
        }
      }
    });
  }
</script>
