      <div class="border-b border-slate-200 pb-3">
        <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-md border border-amber-300 mb-1">
          Interativo
        </div>
        <h2 class="text-2xl font-bold text-slate-900">
          Mini-Quiz Cívico: Teste seus conhecimentos em 3 perguntas
        </h2>
        <p class="text-sm text-slate-600 mt-1">
          Responda e veja se você sabe quem tem poder real para cumprir cada promessa na política brasileira.
        </p>
      </div>

      <div class="bg-gradient-to-br from-white to-slate-50 rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-6">
        
        <!-- Pergunta 1 -->
        <div class="quiz-card space-y-3" data-correta="b">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Pergunta 1 de 3</span>
          </div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900">
            1. O asfalto da sua rua está repleto de buracos e a lâmpada do poste queimou. Quem é a autoridade competente para consertar?
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs">
            <button type="button" class="quiz-btn text-left p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer font-medium text-slate-800" data-resp="a">
              A) Deputado Federal
            </button>
            <button type="button" class="quiz-btn text-left p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer font-medium text-slate-800" data-resp="b">
              B) Prefeito
            </button>
            <button type="button" class="quiz-btn text-left p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer font-medium text-slate-800" data-resp="c">
              C) Governador
            </button>
          </div>
          <div class="quiz-feedback hidden text-xs p-3 rounded-xl"></div>
        </div>

        <!-- Pergunta 2 -->
        <div class="quiz-card space-y-3 border-t border-slate-200/70 pt-5" data-correta="b">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Pergunta 2 de 3</span>
          </div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900">
            2. Um candidato a Vereador prometeu "aumentar a pena de prisão para 30 anos para quem roubar celular no município". Essa promessa é:
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs">
            <button type="button" class="quiz-btn text-left p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer font-medium text-slate-800" data-resp="a">
              A) Verdadeira, vereadores fazem leis penais locais
            </button>
            <button type="button" class="quiz-btn text-left p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer font-medium text-slate-800" data-resp="b">
              B) Falsa, penas criminais só podem ser criadas pelo Congresso Nacional
            </button>
            <button type="button" class="quiz-btn text-left p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer font-medium text-slate-800" data-resp="c">
              C) Verdadeira, desde que o Prefeito autorize
            </button>
          </div>
          <div class="quiz-feedback hidden text-xs p-3 rounded-xl"></div>
        </div>

        <!-- Pergunta 3 -->
        <div class="quiz-card space-y-3 border-t border-slate-200/70 pt-5" data-correta="c">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Pergunta 3 de 3</span>
          </div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900">
            3. Se um Senador em exercício é convidado pelo Presidente para assumir um Ministério, quem ocupa a vaga dele no Senado Federal?
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs">
            <button type="button" class="quiz-btn text-left p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer font-medium text-slate-800" data-resp="a">
              A) O deputado federal mais votado do estado
            </button>
            <button type="button" class="quiz-btn text-left p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer font-medium text-slate-800" data-resp="b">
              B) O segundo colocado na eleição para o Senado
            </button>
            <button type="button" class="quiz-btn text-left p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer font-medium text-slate-800" data-resp="c">
              C) O 1º Suplente registrado na chapa dele
            </button>
          </div>
          <div class="quiz-feedback hidden text-xs p-3 rounded-xl"></div>
        </div>

      </div>
    </section>

    <!-- FONTES E VERIFICABILIDADE -->
    <section class="bg-slate-100/80 rounded-2xl border border-slate-200 p-6 space-y-3 text-xs text-slate-600">
      <h3 class="font-bold text-slate-900 text-sm">
        Fontes Jurídicas e Verificabilidade
      </h3>
      <p>
        As competências e normas institucionais explicadas neste guia são extraídas diretamente da legislação em vigor da República Federativa do Brasil:
      </p>
      <ul class="list-disc list-inside space-y-1 text-slate-700">
        <li>
          <a href="https://www.planalto.gov.br/ccivil_03/constituicao/constituicao.htm" target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:underline">
            Constituição da República Federativa do Brasil de 1988 (CF/88) ↗
          </a>
        </li>
        <li>
          <a href="https://www.planalto.gov.br/ccivil_03/leis/l9504.htm" target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:underline">
            Lei das Eleições (Lei nº 9.504/1997) ↗
          </a>
        </li>
        <li>
          <a href="https://www.planalto.gov.br/ccivil_03/leis/l4737compilado.htm" target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:underline">
            Código Eleitoral Brasileiro (Lei nº 4.737/1965) ↗
          </a>
        </li>
      </ul>
    </section>

  </div>
</Layout>

<script>
  // Filtro de Situações / Problemas do Cidadão
  const inputFiltro = document.getElementById('filtro-problemas') as HTMLInputElement | null;
  const itens = document.querySelectorAll<HTMLElement>('.item-problema');
  const msgSemResultados = document.getElementById('sem-resultados');

  if (inputFiltro) {
    inputFiltro.addEventListener('input', () => {
      const termo = inputFiltro.value.toLowerCase().trim();
      let visiveis = 0;

      itens.forEach(item => {
        const tags = (item.getAttribute('data-tags') || '').toLowerCase();
        const texto = item.textContent?.toLowerCase() || '';

        if (!termo || tags.includes(termo) || texto.includes(termo)) {
          item.style.display = '';
          visiveis++;
        } else {
          item.style.display = 'none';
        }
      });

      if (msgSemResultados) {
        if (visiveis === 0) {
          msgSemResultados.classList.remove('hidden');
        } else {
          msgSemResultados.classList.add('hidden');
        }
      }
    });
  }

  // Lógica Interativa do Mini-Quiz
  const quizCards = document.querySelectorAll<HTMLElement>('.quiz-card');

  const explicacoes: Record<number, { correta: string; explicacao: string }> = {
    0: {
      correta: 'b',
      explicacao: 'Exato! A conservação das vias públicas urbanas, pavimentação e iluminação é competência direta do Prefeito municipal através das secretarias de obras e zeladoria.'
    },
    1: {
      correta: 'b',
      explicacao: 'Correto! Legislar sobre Direito Penal é competência privativa da União (CF/88 Art. 22, I). Apenas Deputados Federais e Senadores no Congresso Nacional podem alterar penas criminais.'
    },
    2: {
      correta: 'c',
      explicacao: 'Muito bem! Ao votar para Senador, a chapa inclui dois suplentes que não recebem votos nominais diretos, mas assumem a cadeira em caso de licença, ministério ou renúncia do titular.'
    }
  };

  quizCards.forEach((card, index) => {
    const correta = card.getAttribute('data-correta');
    const botoes = card.querySelectorAll<HTMLButtonElement>('.quiz-btn');
    const feedback = card.querySelector<HTMLElement>('.quiz-feedback');

    botoes.forEach(btn => {
      btn.addEventListener('click', () => {
        const resp = btn.getAttribute('data-resp');
        if (!feedback) return;

        // Desabilita botões do card após escolha
        botoes.forEach(b => {
          b.disabled = true;
          b.classList.remove('hover:bg-slate-50', 'bg-white');
          if (b.getAttribute('data-resp') === correta) {
            b.classList.add('bg-emerald-100', 'border-emerald-400', 'text-emerald-900', 'font-bold');
          } else if (b === btn) {
            b.classList.add('bg-rose-100', 'border-rose-400', 'text-rose-900');
          } else {
            b.classList.add('opacity-50');
          }
        });

        feedback.classList.remove('hidden');
        if (resp === correta) {
          feedback.className = 'quiz-feedback text-xs p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900';
          feedback.innerHTML = `<strong>Acertou!</strong> ${explicacoes[index]?.explicacao || ''}`;
        } else {
          feedback.className = 'quiz-feedback text-xs p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-900';
          feedback.innerHTML = `<strong>Incorreto.</strong> A resposta certa é a opção ${correta?.toUpperCase()}. ${explicacoes[index]?.explicacao || ''}`;
        }
      });
    });
  });
</script>
