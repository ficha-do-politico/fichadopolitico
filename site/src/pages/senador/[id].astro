---
import Layout from '../../layouts/Layout.astro';
import VotoBadge from '../../components/VotoBadge.astro';
import senadoresData from '../../data/senadores.json';
import temasData from '../../data/temas.json';
import type { Senador, Tema } from '../../types';

const temas = temasData as Tema[];

export async function getStaticPaths() {
  const senadores = senadoresData as Senador[];
  return senadores.map(sen => ({
    params: { id: String(sen.id) },
    props: { senador: sen },
  }));
}

interface Props {
  senador: Senador;
}

const { senador } = Astro.props;

const pageTitle = `Sen. ${senador.nome_eleitoral} (${senador.partido}-${senador.uf})`;
const pageDescription = `Confira a ficha pública do Senador da República ${senador.nome_eleitoral} (${senador.partido}/${senador.uf}) com dados oficiais do Senado Federal.`;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const temVotosRegistrados = Object.keys(senador.votos || {}).length > 0;
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image={senador.url_foto}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <!-- Navegação / Voltar -->
    <div class="mb-6">
      <a href={base} class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-emerald-700 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Voltar para a busca de parlamentares
      </a>
    </div>

    <!-- Card de Perfil do Senador -->
    <header class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col sm:flex-row items-center sm:items-start gap-6">
      <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden bg-slate-100 border-2 border-slate-200 shadow-inner flex-shrink-0">
        <img 
          src={senador.url_foto} 
          alt={senador.nome_eleitoral} 
          class="w-full h-full object-cover object-top"
          onerror={`this.onerror=null; this.src='${base}avatar-placeholder.svg';`}
        />
      </div>

      <div class="text-center sm:text-left flex-1 space-y-3">
        <div class="space-y-1">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
              {senador.nome_eleitoral}
            </h1>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-800 border border-blue-200">
              57ª Legislatura • Senado Federal
            </span>
          </div>
          <p class="text-xs sm:text-sm text-slate-500 font-mono">
            Nome civil: {senador.nome_civil}
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 text-sm">
          <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-semibold bg-slate-100 text-slate-800 border border-slate-200">
            Partido: {senador.partido}
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-semibold bg-slate-100 text-slate-800 border border-slate-200">
            Estado: {senador.uf}
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs text-slate-600 bg-slate-50 border border-slate-200">
            {senador.situacao}
          </span>
        </div>

        <div class="pt-1">
          <a 
            href={senador.url_perfil_senado} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-1.5 text-xs text-blue-700 hover:text-blue-900 font-medium underline underline-offset-2"
          >
            <span>Ver perfil e biografia oficial no Senado Federal</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Contexto e Transparência -->
    <div class="my-8 p-4 rounded-xl bg-slate-100/80 border border-slate-200/80 text-xs text-slate-600 space-y-1">
      <div class="font-semibold text-slate-800 flex items-center gap-1.5">
        <svg class="w-4 h-4 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Sobre a ficha no Senado Federal
      </div>
      <p>
        Esta página integra a expansão bicameral do Ficha do Político (AD-014), cobrindo os 81 Senadores da República em exercício na 57ª Legislatura. Todos os dados são rastreáveis à API oficial de Dados Abertos do Senado Federal.
      </p>
    </div>

    <!-- Seção de Votações -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold text-slate-900">
          Votações Nominais no Senado
        </h2>
        <span class="text-xs text-slate-500 font-medium">
          {temVotosRegistrados ? `${Object.keys(senador.votos).length} registradas` : 'Em catalogação'}
        </span>
      </div>

      {temVotosRegistrados ? (
        <div class="space-y-4">
          {temas.filter(t => senador.votos[t.id]).map(tema => {
            const voto = senador.votos[tema.id] || "Não votou / Ausente";
            return (
              <article class="bg-white rounded-xl border border-slate-200 p-5 sm:p-6 shadow-sm transition hover:border-slate-300">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
                  <div class="space-y-1">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200">
                        {tema.proposicao}
                      </span>
                      <span class="text-xs text-slate-400 font-medium">
                        Data: {tema.data}
                      </span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900">
                      {tema.titulo}
                    </h3>
                    <p class="text-xs sm:text-sm text-slate-600">
                      {tema.subtitulo}
                    </p>
                  </div>

                  <div class="flex flex-col sm:items-end gap-1 flex-shrink-0">
                    <span class="text-xs text-slate-400 font-medium">Voto do senador:</span>
                    <VotoBadge voto={voto} size="lg" />
                  </div>
                </div>

                <div class="pt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
                  <div class="italic text-slate-500">
                    Resultado no plenário: <span class="font-medium text-slate-700">{tema.resultado_oficial}</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <a 
                      href={tema.url_votacao} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="text-blue-700 hover:text-blue-900 underline inline-flex items-center gap-0.5"
                    >
                      <span>Registro oficial da votação ↗</span>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="bg-white rounded-xl border border-slate-200 p-8 text-center space-y-3 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mx-auto text-lg font-bold">
            🏛️
          </div>
          <h3 class="text-base font-semibold text-slate-900">
            Curadoria bicameral do Senado em andamento
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 max-w-md mx-auto leading-relaxed">
            As votações nominais ocorridas no plenário do Senado para as matérias do catálogo nacional (como Reforma Tributária e Marco Temporal) estão sendo mapeadas junto aos IDs da API do Senado.
          </p>
          <div class="pt-2">
            <a 
              href={senador.url_perfil_senado} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 text-xs font-semibold px-4 py-2 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition"
            >
              Consultar votações no portal do Senado ↗
            </a>
          </div>
        </div>
      )}
    </section>
  </div>
</Layout>
