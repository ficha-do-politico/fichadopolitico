---
import Layout from '../../layouts/Layout.astro';
import FichaTabs from '../../components/FichaTabs.astro';
import PartidoLogo from '../../components/PartidoLogo.astro';
import ParlamentarCard from '../../components/ParlamentarCard.astro';
import partidosData from '../../data/partidos.json';
import temasData from '../../data/temas.json';
import deputadosData from '../../data/deputados.json';
import senadoresData from '../../data/senadores.json';
import type { Partido, Tema, Deputado, Senador, ParlamentarCardData } from '../../types';

export async function getStaticPaths() {
  const partidos = partidosData as Partido[];
  return partidos.map((partido) => ({
    params: { sigla: partido.slug },
    props: { partido },
  }));
}

interface Props {
  partido: Partido;
}

const { partido } = Astro.props as Props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const temas = temasData as Tema[];
const temasMap = new Map(temas.map(t => [t.id, t]));

const deputadosAll = deputadosData as Deputado[];
const senadoresAll = senadoresData as Senador[];

const deputadosBancada = deputadosAll.filter(d => partido.bancada.deputados_ids.includes(d.id));
const senadoresBancada = senadoresAll.filter(s => partido.bancada.senadores_ids.includes(s.id));

const deputadosCards: ParlamentarCardData[] = deputadosBancada.map(d => ({
  id: d.id,
  nome_eleitoral: d.nome_eleitoral,
  nome_civil: d.nome_civil,
  partido: d.partido,
  uf: d.uf,
  url_foto: d.url_foto,
  casa: 'camara' as const,
  cargo: 'Deputado Federal',
  href: `${base}deputado/${d.id}`,
  participacao_votacoes: d.participacao_votacoes,
  is_candidato_2026: Boolean(d.candidatura_2026),
  is_reeleicao: d.candidatura_2026?.reeleicao,
  cargo_2026: d.candidatura_2026?.cargo,
  total_cota: d.despesas_2026?.total_gasto,
  total_cota_formatado: d.despesas_2026?.total_formatado,
  total_emendas: d.emendas?.total_pago,
  total_emendas_formatado: d.emendas?.total_pago_formatado,
})).sort((a, b) => a.nome_eleitoral.localeCompare(b.nome_eleitoral, 'pt-BR'));

const senadoresCards: ParlamentarCardData[] = senadoresBancada.map(s => ({
  id: s.id,
  nome_eleitoral: s.nome_eleitoral,
  nome_civil: s.nome_civil,
  partido: s.partido,
  uf: s.uf,
  url_foto: s.url_foto,
  casa: 'senado' as const,
  cargo: 'Senador',
  href: `${base}senador/${s.id}`,
  participacao_votacoes: s.participacao_votacoes,
  is_candidato_2026: Boolean(s.candidatura_2026),
  is_reeleicao: s.candidatura_2026?.reeleicao,
  cargo_2026: s.candidatura_2026?.cargo,
  total_cota: s.despesas_2026?.total_gasto,
  total_cota_formatado: s.despesas_2026?.total_formatado,
  total_emendas: s.emendas?.total_pago,
  total_emendas_formatado: s.emendas?.total_pago_formatado,
})).sort((a, b) => a.nome_eleitoral.localeCompare(b.nome_eleitoral, 'pt-BR'));

function formatMoeda(val: number): string {
  return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 }).format(val);
}

function getOrientacaoBadgeClass(orientacao?: string): string {
  if (orientacao === 'Sim') return 'bg-emerald-50 text-emerald-800 border-emerald-300';
  if (orientacao === 'Não') return 'bg-rose-50 text-rose-800 border-rose-300';
  if (orientacao === 'Liberado') return 'bg-blue-50 text-blue-800 border-blue-300';
  return 'bg-slate-100 text-slate-700 border-slate-300';
}

const totalVotacoes = partido.votacoes.camara.total_temas + partido.votacoes.senado.total_temas;
const temBancada = partido.bancada.total_congresso > 0;

const tabs = [
  { key: 'votacoes', label: `Votações Nominais (${totalVotacoes})` },
  { key: 'bancada', label: `Bancada no Congresso (${partido.bancada.total_congresso})` },
  { key: 'recursos', label: 'Recursos sob Gestão' },
  { key: 'estatuto', label: 'Estatuto & Registro TSE' },
];

const pageTitle = `${partido.sigla} - ${partido.nome} | Guia de Partidos`;
const pageDescription = `Consulte a ficha oficial do ${partido.nome} (${partido.sigla}): número ${partido.numero_eleitoral} no TSE, autodeclaração estatutária literal, bancada de ${partido.bancada.total_congresso} parlamentares e matriz completa de votações.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 space-y-8">
    
    <!-- Navegação / Voltar -->
    <div>
      <a href={`${base}partidos/`} class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-slate-500 hover:text-emerald-700 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Voltar para o Guia de Partidos
      </a>
    </div>

    <!-- Bloco 1: Identidade Oficial & Registro TSE (Header) -->
    <header class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6 border-b border-slate-100 pb-6">
        <div class="flex items-start gap-4 sm:gap-5">
          <!-- Logo Oficial do Partido -->
          <PartidoLogo
            slug={partido.slug}
            sigla={partido.sigla}
            numeroEleitoral={partido.numero_eleitoral}
            size="lg"
          />

          <!-- Número de Urna em Destaque Visual -->
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-slate-900 text-white flex flex-col items-center justify-center shrink-0 shadow-sm">
            <span class="text-[11px] sm:text-xs uppercase font-medium leading-none text-slate-400">Nº</span>
            <span class="text-2xl sm:text-3xl font-black leading-none mt-1">{partido.numero_eleitoral}</span>
          </div>

          <div class="space-y-1">
            <div class="flex items-center gap-2.5 flex-wrap">
              <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
                {partido.sigla}
              </h1>
              {partido.federacao && (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-blue-50 text-blue-800 border border-blue-200">
                  Federação: {partido.federacao.sigla}
                </span>
              )}
              {!temBancada && (
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-slate-100 text-slate-600">
                  Sem representação no Congresso
                </span>
              )}
            </div>
            <p class="text-base sm:text-lg font-semibold text-slate-700 leading-snug">
              {partido.nome}
            </p>
            <p class="text-xs text-slate-500 pt-0.5">
              Presidente Nacional Registrado: <strong class="text-slate-800 font-semibold">{partido.presidente_nacional}</strong>
            </p>
          </div>
        </div>

        <!-- Links Oficiais do TSE -->
        <div class="flex flex-col sm:items-end gap-2 shrink-0">
          <a 
            href={partido.fonte_oficial_tse} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 transition"
          >
            <span>Registro Oficial TSE</span>
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <span class="text-[11px] text-slate-400">
            Deferimento TSE: {partido.deferimento}
          </span>
        </div>
      </div>

      <!-- Bloco 2: Autodeclaração Estatutária Literal (Art. 1º) -->
      <section class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 sm:p-5 space-y-3" aria-label="Autodeclaração Estatutária">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs text-slate-600">
          <span class="font-bold text-slate-900 inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Autodeclaração Estatutária Literal ({partido.autodeclaracao.artigo})
          </span>
          <span class="text-[11px] text-slate-500">Documento aprovado pela Justiça Eleitoral</span>
        </div>
        <blockquote class="italic text-xs sm:text-sm text-slate-800 border-l-3 border-emerald-600 pl-3.5 leading-relaxed">
          "{partido.autodeclaracao.texto}"
        </blockquote>
        <p class="text-[11px] text-slate-500 leading-normal">
          <strong>Diretriz de Apartidarismo (AD-004):</strong> A Ficha do Político não classifica agremiações em rótulos subjetivos ou espectros ideológicos de terceiros. A declaração de princípios acima reflete textualmente o estatuto oficial registrado no TSE.
        </p>
      </section>

      <!-- Grade de Indicadores Principais -->
      <section class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs" aria-label="Resumo institucional do partido">
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide block">Bancada no Congresso</span>
          <div class="flex items-baseline gap-1.5">
            <span class="text-xl sm:text-2xl font-black text-slate-900">{partido.bancada.total_congresso}</span>
            <span class="text-slate-500 text-[11px]">({partido.bancada.percentual_congresso}%)</span>
          </div>
          <span class="text-[11px] text-slate-600 block">
            {partido.bancada.deputados} Dep. • {partido.bancada.senadores} Sen.
          </span>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide block">Fidelidade Partidária</span>
          <div class="flex items-baseline gap-1">
            {partido.coesao.media_adesao_orientacao !== null ? (
              <>
                <span class={`text-xl sm:text-2xl font-black ${partido.coesao.media_adesao_orientacao >= 80 ? 'text-emerald-700' : 'text-slate-800'}`}>
                  {partido.coesao.media_adesao_orientacao}%
                </span>
                <span class="text-[11px] text-slate-500">média</span>
              </>
            ) : (
              <span class="text-xs text-slate-500 italic">Sem votações c/ orientação</span>
            )}
          </div>
          <span class="text-[11px] text-slate-500 block">
            {partido.coesao.total_votacoes_avaliadas} votações orientadas
          </span>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide block">Cota 2026 (CEAP/CEAPS)</span>
          <span class="text-sm sm:text-base font-bold text-slate-900 block truncate" title={`Total: ${formatMoeda(partido.recursos.total_cota_2026)}`}>
            {partido.recursos.total_cota_2026 > 0 ? formatMoeda(partido.recursos.total_cota_2026) : 'R$ 0'}
          </span>
          <span class="text-[11px] text-slate-500 block truncate">
            Câmara: {formatMoeda(partido.recursos.ceap_camara_2026)}
          </span>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide block">Emendas Pagas (57ª Leg)</span>
          <span class="text-sm sm:text-base font-bold text-slate-900 block truncate" title={`Total: ${formatMoeda(partido.recursos.emendas_cgu_pagas)}`}>
            {partido.recursos.emendas_cgu_pagas > 0 ? formatMoeda(partido.recursos.emendas_cgu_pagas) : 'R$ 0'}
          </span>
          <span class="text-[11px] text-slate-500 block truncate">
            Pix: {formatMoeda(partido.recursos.emendas_pix_pagas)}
          </span>
        </div>
      </section>
    </header>

    <!-- Conteúdo com Abas Estruturadas -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
      <FichaTabs tabs={tabs}>

        <!-- ABA 1: Matriz Completa de Votações Nominais & Coesão -->
        <div slot="votacoes" class="space-y-8">
          <div class="border-b border-slate-100 pb-4 space-y-1">
            <h2 class="text-lg sm:text-xl font-bold text-slate-900">
              Matriz de Votações Nominais e Comportamento de Bancada
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Confira a distribuição exata dos votos dos parlamentares do <strong>{partido.sigla}</strong> em matérias de grande impacto público, comparada à orientação oficial da liderança da bancada em plenário.
            </p>
          </div>

          <!-- Seção Câmara dos Deputados -->
          <div class="space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-2">
              <h3 class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
                Câmara dos Deputados ({partido.votacoes.camara.total_temas} votações catalogadas)
              </h3>
              <span class="text-xs text-slate-500">Bancada: {partido.bancada.deputados} deputados</span>
            </div>

            <div class="space-y-3">
              {partido.votacoes.camara.temas.map((v) => {
                const temaRef = temasMap.get(v.tema_id);
                const dist = v.distribuicao_votos;
                const totalDeputados = partido.bancada.deputados;
                const baseCalculo = totalDeputados > 0 ? totalDeputados : 1;
                
                const pctSim = totalDeputados > 0 ? ((dist.sim / baseCalculo) * 100).toFixed(0) : '0';
                const pctNao = totalDeputados > 0 ? ((dist.nao / baseCalculo) * 100).toFixed(0) : '0';
                const pctAbst = totalDeputados > 0 ? ((dist.abstencao / baseCalculo) * 100).toFixed(0) : '0';
                const pctAus = totalDeputados > 0 ? ((dist.ausente / baseCalculo) * 100).toFixed(0) : '0';

                return (
                  <article class="p-4 sm:p-5 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition space-y-3">
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                      <div class="space-y-1">
                        <div class="flex items-center gap-2 flex-wrap">
                          <h4 class="font-bold text-sm sm:text-base text-slate-900">
                            {temaRef ? (
                              <a href={`${base}votacao/${temaRef.id}`} class="hover:text-emerald-700 transition">
                                {v.tema_titulo}
                              </a>
                            ) : (
                              v.tema_titulo
                            )}
                          </h4>
                          {temaRef && (
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-100 text-slate-700">
                              {temaRef.proposicao}
                            </span>
                          )}
                        </div>
                        {temaRef?.data && (
                          <span class="text-[11px] text-slate-500 block">
                            Data de deliberação: {temaRef.data} • {temaRef.resultado_oficial}
                          </span>
                        )}
                      </div>

                      <!-- Orientação e Adesão -->
                      <div class="flex items-center gap-2 shrink-0">
                        {v.orientacao_bancada && (
                          <div class="text-right">
                            <span class="text-[10px] uppercase font-semibold text-slate-400 block">Orientação</span>
                            <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border ${getOrientacaoBadgeClass(v.orientacao_bancada)}`}>
                              {v.orientacao_bancada}
                            </span>
                          </div>
                        )}
                        {v.taxa_adesao_orientacao !== null && v.taxa_adesao_orientacao !== undefined && (
                          <div class="text-right pl-2 border-l border-slate-200">
                            <span class="text-[10px] uppercase font-semibold text-slate-400 block">Fidelidade</span>
                            <span class={`text-xs font-extrabold ${v.taxa_adesao_orientacao >= 80 ? 'text-emerald-700' : 'text-slate-800'}`}>
                              {v.taxa_adesao_orientacao}%
                            </span>
                          </div>
                        )}
                      </div>
                    </div>

                    <!-- Barra de Distribuição de Votos -->
                    <div class="space-y-1.5">
                      <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden flex" title={`Sim: ${dist.sim} | Não: ${dist.nao} | Abstenção: ${dist.abstencao} | Ausente: ${dist.ausente}`}>
                        {dist.sim > 0 && <div style={`width: ${pctSim}%`} class="bg-emerald-500 h-full"></div>}
                        {dist.nao > 0 && <div style={`width: ${pctNao}%`} class="bg-rose-500 h-full"></div>}
                        {dist.abstencao > 0 && <div style={`width: ${pctAbst}%`} class="bg-amber-400 h-full"></div>}
                        {dist.ausente > 0 && <div style={`width: ${pctAus}%`} class="bg-slate-300 h-full"></div>}
                      </div>

                      <!-- Legenda Numérica -->
                      <div class="flex items-center justify-between text-[11px] text-slate-600 flex-wrap gap-2 pt-0.5">
                        <div class="flex items-center gap-3">
                          <span class="inline-flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                            Sim: <strong>{dist.sim}</strong>
                          </span>
                          <span class="inline-flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                            Não: <strong>{dist.nao}</strong>
                          </span>
                          {dist.abstencao > 0 && (
                            <span class="inline-flex items-center gap-1">
                              <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                              Abst.: <strong>{dist.abstencao}</strong>
                            </span>
                          )}
                          <span class="inline-flex items-center gap-1 text-slate-500">
                            <span class="w-2 h-2 rounded-full bg-slate-300"></span>
                            Ausente: <strong>{dist.ausente}</strong>
                          </span>
                        </div>

                        {temaRef && (
                          <div class="flex items-center gap-2">
                            <a 
                              href={temaRef.url_votacao} 
                              target="_blank" 
                              rel="noopener noreferrer" 
                              class="text-[11px] text-slate-500 hover:text-emerald-700 underline inline-flex items-center gap-1"
                            >
                              <span>Painel da Câmara</span>
                              <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            </a>
                          </div>
                        )}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>

          <!-- Seção Senado Federal -->
          <div class="space-y-4 pt-4 border-t border-slate-100">
            <div class="flex items-center justify-between border-b border-slate-100 pb-2">
              <h3 class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                Senado Federal ({partido.votacoes.senado.total_temas} votações catalogadas)
              </h3>
              <span class="text-xs text-slate-500">Bancada: {partido.bancada.senadores} senadores</span>
            </div>

            {partido.votacoes.senado.temas.length > 0 ? (
              <div class="space-y-3">
                {partido.votacoes.senado.temas.map((v) => {
                  const temaRef = temasMap.get(v.tema_id);
                  const dist = v.distribuicao_votos;
                  const totalSenadores = partido.bancada.senadores;
                  const baseCalculo = totalSenadores > 0 ? totalSenadores : 1;
                  
                  const pctSim = totalSenadores > 0 ? ((dist.sim / baseCalculo) * 100).toFixed(0) : '0';
                  const pctNao = totalSenadores > 0 ? ((dist.nao / baseCalculo) * 100).toFixed(0) : '0';
                  const pctAbst = totalSenadores > 0 ? ((dist.abstencao / baseCalculo) * 100).toFixed(0) : '0';
                  const pctAus = totalSenadores > 0 ? ((dist.ausente / baseCalculo) * 100).toFixed(0) : '0';

                  return (
                    <article class="p-4 sm:p-5 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition space-y-3">
                      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                        <div class="space-y-1">
                          <div class="flex items-center gap-2 flex-wrap">
                            <h4 class="font-bold text-sm sm:text-base text-slate-900">
                              {temaRef ? (
                                <a href={`${base}votacao/${temaRef.id}`} class="hover:text-blue-700 transition">
                                  {v.tema_titulo}
                                </a>
                              ) : (
                                v.tema_titulo
                              )}
                            </h4>
                            {temaRef?.senado && (
                              <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                                {temaRef.senado.proposicao}
                              </span>
                            )}
                          </div>
                          {temaRef?.senado?.data && (
                            <span class="text-[11px] text-slate-500 block">
                              Data de deliberação: {temaRef.senado.data} • {temaRef.senado.resultado_oficial}
                            </span>
                          )}
                        </div>
                      </div>

                      <!-- Barra de Distribuição de Votos -->
                      <div class="space-y-1.5">
                        <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden flex" title={`Sim: ${dist.sim} | Não: ${dist.nao} | Abstenção: ${dist.abstencao} | Ausente: ${dist.ausente}`}>
                          {dist.sim > 0 && <div style={`width: ${pctSim}%`} class="bg-emerald-500 h-full"></div>}
                          {dist.nao > 0 && <div style={`width: ${pctNao}%`} class="bg-rose-500 h-full"></div>}
                          {dist.abstencao > 0 && <div style={`width: ${pctAbst}%`} class="bg-amber-400 h-full"></div>}
                          {dist.ausente > 0 && <div style={`width: ${pctAus}%`} class="bg-slate-300 h-full"></div>}
                        </div>

                        <!-- Legenda Numérica -->
                        <div class="flex items-center justify-between text-[11px] text-slate-600 flex-wrap gap-2 pt-0.5">
                          <div class="flex items-center gap-3">
                            <span class="inline-flex items-center gap-1">
                              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                              Sim: <strong>{dist.sim}</strong>
                            </span>
                            <span class="inline-flex items-center gap-1">
                              <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                              Não: <strong>{dist.nao}</strong>
                            </span>
                            {dist.abstencao > 0 && (
                              <span class="inline-flex items-center gap-1">
                                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                Abst.: <strong>{dist.abstencao}</strong>
                              </span>
                            )}
                            <span class="inline-flex items-center gap-1 text-slate-500">
                              <span class="w-2 h-2 rounded-full bg-slate-300"></span>
                              Ausente: <strong>{dist.ausente}</strong>
                            </span>
                          </div>

                          {temaRef?.senado && (
                            <div class="flex items-center gap-2">
                              <a 
                                href={temaRef.senado.url_votacao} 
                                target="_blank" 
                                rel="noopener noreferrer" 
                                class="text-[11px] text-slate-500 hover:text-blue-700 underline inline-flex items-center gap-1"
                              >
                                <span>Painel do Senado</span>
                                <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                </svg>
                              </a>
                            </div>
                          )}
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            ) : (
              <div class="p-6 text-center rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-500">
                O partido não possui votações nominais registradas no Senado Federal nesta legislatura.
              </div>
            )}
          </div>
        </div>

        <!-- ABA 2: Bancada no Congresso Nacional (Deputados e Senadores) -->
        <div slot="bancada" class="space-y-8">
          <div class="border-b border-slate-100 pb-4 space-y-1">
            <h2 class="text-lg sm:text-xl font-bold text-slate-900">
              Parlamentares da Bancada Federal ({partido.bancada.total_congresso} assentos)
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Relação oficial de deputados e senadores filiados ao <strong>{partido.sigla}</strong> em exercício na 57ª Legislatura do Congresso Nacional.
            </p>
          </div>

          {temBancada ? (
            <div class="space-y-8">
              <!-- Deputados Federais -->
              {deputadosCards.length > 0 && (
                <div class="space-y-3">
                  <div class="flex items-center justify-between">
                    <h3 class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-2">
                      <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
                      Deputados Federais ({deputadosCards.length})
                    </h3>
                    <a 
                      href={`${base}?partido=${encodeURIComponent(partido.sigla)}`}
                      class="text-xs text-emerald-700 hover:text-emerald-800 font-semibold"
                    >
                      Filtrar na busca geral →
                    </a>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    {deputadosCards.map(par => (
                      <ParlamentarCard parlamentar={par} />
                    ))}
                  </div>
                </div>
              )}

              <!-- Senadores da República -->
              {senadoresCards.length > 0 && (
                <div class="space-y-3 pt-4 border-t border-slate-100">
                  <div class="flex items-center justify-between">
                    <h3 class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-2">
                      <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                      Senadores da República ({senadoresCards.length})
                    </h3>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    {senadoresCards.map(par => (
                      <ParlamentarCard parlamentar={par} />
                    ))}
                  </div>
                </div>
              )}
            </div>
          ) : (
            <div class="p-8 text-center rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
              <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <p class="text-slate-800 font-bold text-sm">Sem representação no Congresso Nacional</p>
              <p class="text-xs text-slate-500 max-w-md mx-auto leading-relaxed">
                O {partido.nome} ({partido.sigla}) possui registro definitivo ativo perante o TSE e está formalmente apto a concorrer em eleições, mas não elegeu ou filiou parlamentares em exercício nesta legislatura.
              </p>
            </div>
          )}
        </div>

        <!-- ABA 3: Recursos Públicos sob Gestão -->
        <div slot="recursos" class="space-y-8">
          <div class="border-b border-slate-100 pb-4 space-y-1">
            <h2 class="text-lg sm:text-xl font-bold text-slate-900">
              Recursos Públicos sob Gestão da Bancada
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Consolidação de despesas operacionais da Cota Parlamentar (exercício 2026) e execução orçamentária de Emendas Parlamentares da 57ª Legislatura (2023–2026) via Controladoria-Geral da União (CGU).
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Card de Cota Parlamentar -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 space-y-5">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div>
                  <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 block">Cota Discricionária</span>
                  <h3 class="text-lg font-bold text-slate-900">Cota Parlamentar 2026 (CEAP / CEAPS)</h3>
                </div>
                <span class="px-2.5 py-1 rounded-md text-xs font-bold bg-slate-100 text-slate-700">
                  Exercício Vigente
                </span>
              </div>

              <div class="space-y-1">
                <span class="text-2xl sm:text-3xl font-extrabold text-slate-900 block">
                  {formatMoeda(partido.recursos.total_cota_2026)}
                </span>
                <span class="text-xs text-slate-500">
                  Total de gastos operacionais reembolsados aos deputados e senadores da bancada.
                </span>
              </div>

              <div class="space-y-2.5 pt-2 text-xs">
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                  <span class="text-slate-600 font-medium">CEAP (Câmara dos Deputados):</span>
                  <strong class="text-slate-900">{formatMoeda(partido.recursos.ceap_camara_2026)}</strong>
                </div>
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                  <span class="text-slate-600 font-medium">CEAPS (Senado Federal):</span>
                  <strong class="text-slate-900">{formatMoeda(partido.recursos.ceaps_senado_2026)}</strong>
                </div>
                {temBancada && (
                  <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                    <span class="text-slate-600 font-medium">Média por parlamentar em exercício:</span>
                    <strong class="text-slate-900">
                      {formatMoeda(partido.recursos.total_cota_2026 / partido.bancada.total_congresso)}
                    </strong>
                  </div>
                )}
              </div>

              <p class="text-[11px] text-slate-500 leading-relaxed border-t border-slate-100 pt-3">
                <strong>Critério AD-019 / AD-020:</strong> A Cota para Exercício da Atividade Parlamentar cobre passagens aéreas, combustível, consultorias e divulgação. Não se confunde com salários nem com verba de gabinete para contratação de pessoal.
              </p>
            </div>

            <!-- Card de Emendas Parlamentares CGU -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 space-y-5">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div>
                  <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 block">Orçamento da União</span>
                  <h3 class="text-lg font-bold text-slate-900">Emendas Pagas (CGU 2023–2026)</h3>
                </div>
                <span class="px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                  57ª Legislatura
                </span>
              </div>

              <div class="space-y-1">
                <span class="text-2xl sm:text-3xl font-extrabold text-emerald-800 block">
                  {formatMoeda(partido.recursos.emendas_cgu_pagas)}
                </span>
                <span class="text-xs text-slate-500">
                  Total de emendas individuais e de bancada efetivamente pagas pelo Governo Federal.
                </span>
              </div>

              <div class="space-y-2.5 pt-2 text-xs">
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                  <div>
                    <span class="text-slate-700 font-semibold block">Transferências com Finalidade Definida:</span>
                    <span class="text-[11px] text-slate-500">Recursos vinculados a órgãos e políticas públicas específicas</span>
                  </div>
                  <strong class="text-slate-900 text-sm">{formatMoeda(partido.recursos.emendas_definida_pagas)}</strong>
                </div>

                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                  <div>
                    <span class="text-slate-700 font-semibold block">Transferências Especiais ("Emendas Pix"):</span>
                    <span class="text-[11px] text-slate-500">Repasses diretos a estados e municípios sem convênio prévio</span>
                  </div>
                  <strong class="text-slate-900 text-sm">{formatMoeda(partido.recursos.emendas_pix_pagas)}</strong>
                </div>
              </div>

              <p class="text-[11px] text-slate-500 leading-relaxed border-t border-slate-100 pt-3">
                <strong>Critério AD-016:</strong> Dados oficiais consolidados a partir da base aberta de Emendas Parlamentares da Controladoria-Geral da União (CGU), atualizada conforme a execução financeira do Portal da Transparência.
              </p>
            </div>
          </div>
        </div>

        <!-- ABA 4: Estatuto & Registro TSE -->
        <div slot="estatuto" class="space-y-6">
          <div class="border-b border-slate-100 pb-4 space-y-1">
            <h2 class="text-lg sm:text-xl font-bold text-slate-900">
              Registro Cartorial e Estatutário Oficial no TSE
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Metadados institucionais extraídos diretamente do Sistema de Gerenciamento de Informações Partidárias (SGIP) do Tribunal Superior Eleitoral.
            </p>
          </div>

          <div class="bg-slate-50/60 rounded-2xl border border-slate-200 p-6 space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
              <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1">
                <span class="text-slate-500 font-medium block">Número Eleitoral Oficial:</span>
                <span class="text-lg font-black text-slate-900 block">{partido.numero_eleitoral}</span>
              </div>

              <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1">
                <span class="text-slate-500 font-medium block">Data de Deferimento TSE:</span>
                <span class="text-lg font-bold text-slate-900 block">{partido.deferimento}</span>
              </div>

              <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1">
                <span class="text-slate-500 font-medium block">Data de Fundação:</span>
                <span class="text-lg font-bold text-slate-900 block">{partido.criacao || 'Não informada'}</span>
              </div>

              <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1 sm:col-span-2">
                <span class="text-slate-500 font-medium block">Presidente Nacional Registrado (SGIP):</span>
                <span class="text-base font-bold text-slate-900 block">{partido.presidente_nacional}</span>
              </div>

              <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1">
                <span class="text-slate-500 font-medium block">Federação Partidária:</span>
                <span class="text-base font-bold text-slate-900 block">
                  {partido.federacao ? `${partido.federacao.nome} (${partido.federacao.sigla})` : 'Nenhuma (atuação isolada)'}
                </span>
              </div>
            </div>

            <!-- Íntegra do Artigo 1º Registrado -->
            <div class="p-5 rounded-xl bg-white border border-slate-200 space-y-3">
              <span class="text-xs font-bold text-slate-900 uppercase tracking-wide block">
                {partido.autodeclaracao.artigo}
              </span>
              <p class="text-sm italic text-slate-800 leading-relaxed border-l-2 border-slate-300 pl-4">
                "{partido.autodeclaracao.texto}"
              </p>
            </div>

            <div class="flex items-center justify-between gap-4 pt-2 flex-wrap">
              <span class="text-xs text-slate-500">
                Fonte primária oficial: Repositório de Partidos Registrados do TSE
              </span>
              <a 
                href={partido.fonte_oficial_tse} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-700 text-white hover:bg-emerald-800 font-semibold text-xs transition shadow-xs"
              >
                <span>Acessar portal oficial no TSE</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        </div>

      </FichaTabs>
    </section>

  </div>
</Layout>
