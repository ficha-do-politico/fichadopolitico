---
import Layout from '../layouts/Layout.astro';
import DeputadoCard from '../components/DeputadoCard.astro';
import deputadosData from '../data/deputados.json';
import temasData from '../data/temas.json';
import type { Deputado, Tema } from '../types';

const deputados = deputadosData as Deputado[];
const temas = temasData as Tema[];

const totalDeputados = deputados.length;
const totalTemas = temas.length;

// Lista única ordenada de partidos e estados para filtros rápidos
const partidos = [...new Set(deputados.map(d => d.partido))].sort();
const ufs = [...new Set(deputados.map(d => d.uf))].sort();
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Início">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-emerald-50/60 via-slate-50 to-slate-50 pt-16 pb-12 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center space-y-5">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100/80 border border-emerald-300/60 text-emerald-800 text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        Dados Oficiais da Câmara dos Deputados • 57ª Legislatura
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Como votou seu deputado federal?
      </h1>

      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        A maneira mais simples, transparente e apartidária de acompanhar como os <strong class="text-slate-900">{totalDeputados} deputados</strong> votaram em <strong class="text-slate-900">{totalTemas} decisões cruciais</strong> para o Brasil.
      </p>

      <!-- Barra de Busca Hero -->
      <div class="pt-4 max-w-2xl mx-auto">
        <div class="relative shadow-sm rounded-2xl">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Busque por nome do deputado, partido ou estado (ex: Arthur Lira, SP, PT)..."
            autocomplete="off"
            class="w-full pl-11 pr-10 py-4 text-base sm:text-lg rounded-2xl border border-slate-300 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition outline-none bg-white text-slate-900 placeholder:text-slate-400"
          />
          <button 
            id="clearSearch" 
            type="button" 
            class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-600 transition"
            aria-label="Limpar busca"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Filtros rápidos por UF ou Partido -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-3 text-xs text-slate-500">
          <span>Filtrar por UF:</span>
          <select id="filterUf" class="bg-white border border-slate-200 rounded px-2 py-1 text-slate-700 outline-none focus:border-emerald-500">
            <option value="">Todos os estados</option>
            {ufs.map(uf => <option value={uf.toLowerCase()}>{uf}</option>)}
          </select>

          <span class="ml-2">Partido:</span>
          <select id="filterPartido" class="bg-white border border-slate-200 rounded px-2 py-1 text-slate-700 outline-none focus:border-emerald-500">
            <option value="">Todos os partidos</option>
            {partidos.map(p => <option value={p.toLowerCase()}>{p}</option>)}
          </select>
        </div>
      </div>
    </div>
  </section>

  <!-- Lista de Deputados -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-6">
    <div class="flex items-center justify-between pb-4 border-b border-slate-200 text-sm">
      <span class="text-slate-500">
        Mostrando <strong id="visibleCount" class="text-slate-900 font-semibold">{totalDeputados}</strong> de {totalDeputados} deputados federais
      </span>
      <a href={`${base}criterios`} class="text-emerald-700 hover:underline font-medium text-xs sm:text-sm">
        Ver os {totalTemas} temas curados ↗
      </a>
    </div>

    <!-- Grid de Cards -->
    <div id="deputadosGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-6">
      {deputados.map(dep => (
        <div class="deputado-item">
          <DeputadoCard deputado={dep} />
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden py-16 text-center space-y-3">
      <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto text-xl font-bold">
        ?
      </div>
      <h3 class="text-lg font-semibold text-slate-900">Nenhum deputado encontrado</h3>
      <p class="text-sm text-slate-500 max-w-sm mx-auto">
        Tente buscar com outra grafia, apenas o primeiro nome ou selecione o estado/partido.
      </p>
    </div>
  </section>

  <!-- Script de Busca Client-Side Ultra-rápido -->
  <script is:inline>
    const input = document.getElementById('searchInput');
    const clearBtn = document.getElementById('clearSearch');
    const filterUf = document.getElementById('filterUf');
    const filterPartido = document.getElementById('filterPartido');
    const grid = document.getElementById('deputadosGrid');
    const items = Array.from(grid.getElementsByClassName('deputado-item'));
    const visibleCount = document.getElementById('visibleCount');
    const emptyState = document.getElementById('emptyState');

    let debounceTimer = null;

    function renderFilter() {
      const q = input.value.trim().toLowerCase();
      const uf = filterUf.value;
      const partido = filterPartido.value;

      clearBtn.classList.toggle('hidden', q.length === 0);

      window.requestAnimationFrame(() => {
        let visible = 0;
        for (let i = 0; i < items.length; i++) {
          const item = items[i];
          const link = item.querySelector('a');
          const nome = link.getAttribute('data-nome') || '';
          const civil = link.getAttribute('data-civil') || '';
          const p = link.getAttribute('data-partido') || '';
          const u = link.getAttribute('data-uf') || '';

          const matchesQuery = !q || nome.includes(q) || civil.includes(q) || p.includes(q) || u.includes(q);
          const matchesUf = !uf || u === uf;
          const matchesPartido = !partido || p === partido;

          if (matchesQuery && matchesUf && matchesPartido) {
            item.style.display = '';
            visible++;
          } else {
            item.style.display = 'none';
          }
        }

        visibleCount.textContent = visible;
        emptyState.classList.toggle('hidden', visible > 0);
      });
    }

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(renderFilter, 150);
    });
    filterUf.addEventListener('change', renderFilter);
    filterPartido.addEventListener('change', renderFilter);

    clearBtn.addEventListener('click', () => {
      input.value = '';
      renderFilter();
      input.focus();
    });
  </script>
</Layout>
