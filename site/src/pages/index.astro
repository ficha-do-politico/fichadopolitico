---
import Layout from '../layouts/Layout.astro';
import ParlamentarCard from '../components/ParlamentarCard.astro';
import ParlamentarTableRow from '../components/ParlamentarTableRow.astro';
import deputadosData from '../data/deputados.json';
import senadoresData from '../data/senadores.json';
import temasData from '../data/temas.json';
import tseStatus from '../data/tse_status.json';
import type { Deputado, Senador, Tema, ParlamentarCardData } from '../types';

const deputados = deputadosData as Deputado[];
const senadores = senadoresData as Senador[];
const temas = temasData as Tema[];

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const parlamentares: ParlamentarCardData[] = [
  ...deputados.map(d => ({
    id: d.id,
    nome_eleitoral: d.nome_eleitoral,
    nome_civil: d.nome_civil,
    partido: d.partido,
    uf: d.uf,
    url_foto: d.url_foto,
    casa: 'camara' as const,
    cargo: 'Deputado Federal',
    href: `${base}deputado/${d.id}`,
    is_candidato_2026: !!d.candidatura_2026,
    is_reeleicao: d.candidatura_2026?.reeleicao ?? false,
    cargo_2026: d.candidatura_2026?.cargo,
    total_cota_formatado: d.despesas_2026?.total_formatado,
    total_cota: d.despesas_2026?.total_gasto,
    total_votos: Object.keys(d.votos || {}).length,
    participacao_votacoes: d.participacao_votacoes,
    patrimonio_formatado: d.candidatura_2026?.patrimonio?.total_formatado,
    patrimonio_total: d.candidatura_2026?.patrimonio?.total_declarado,
    total_emendas_formatado: d.emendas?.total_pago_formatado,
    total_emendas: d.emendas?.total_pago,
  })),
  ...senadores.map(s => ({
    id: s.id,
    nome_eleitoral: s.nome_eleitoral,
    nome_civil: s.nome_civil,
    partido: s.partido,
    uf: s.uf,
    url_foto: s.url_foto,
    casa: 'senado' as const,
    cargo: 'Senador',
    href: `${base}senador/${s.id}`,
    is_candidato_2026: !!s.candidatura_2026,
    is_reeleicao: s.candidatura_2026?.reeleicao ?? false,
    cargo_2026: s.candidatura_2026?.cargo,
    total_cota_formatado: s.despesas_2026?.total_formatado,
    total_cota: s.despesas_2026?.total_gasto,
    total_votos: Object.keys(s.votos || {}).length,
    participacao_votacoes: s.participacao_votacoes,
    patrimonio_formatado: s.candidatura_2026?.patrimonio?.total_formatado,
    patrimonio_total: s.candidatura_2026?.patrimonio?.total_declarado,
    total_emendas_formatado: s.emendas?.total_pago_formatado,
    total_emendas: s.emendas?.total_pago,
  })),
].sort((a, b) => a.nome_eleitoral.localeCompare(b.nome_eleitoral, 'pt-BR'));

const totalDeputados = deputados.length;
const totalSenadores = senadores.length;
const totalParlamentares = parlamentares.length;
const totalTemas = temas.length;
const totalCandidatos2026 = parlamentares.filter(p => p.is_candidato_2026).length;
const totalReeleicao2026 = parlamentares.filter(p => p.is_reeleicao).length;
// Módulo TSE 2026 suspenso até a correção da auditoria (docs/auditoria-dados-tse-2026.md)
const mostrarTse = !tseStatus.suspenso;

// Lista única ordenada de partidos e estados para filtros rápidos
const partidos = [...new Set(parlamentares.map(p => p.partido))].filter(Boolean).sort();
const ufs = [...new Set(parlamentares.map(p => p.uf))].filter(Boolean).sort();
---

<Layout title="Início">
  <!-- Hero Section Editorial -->
  <section class="relative bg-slate-50 border-b border-slate-200/80 pt-12 pb-10 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center space-y-5">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-slate-200 text-slate-700 text-xs font-semibold shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
        Auditoria Cívica Apartidária • 100% Fontes Primárias Oficiais
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        A ficha pública de quem governa e legisla no Brasil
      </h1>

      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Acesse em dados crus e auditáveis como votaram os <strong class="text-slate-900">{totalDeputados} deputados</strong> e <strong class="text-slate-900">{totalSenadores} senadores</strong>, o detalhamento das despesas de cota parlamentar{mostrarTse ? ' e o patrimônio autodeclarado à Justiça Eleitoral' : ' e as emendas pagas'}.
      </p>

      <!-- Barra de Busca Hero -->
      <div class="pt-2 max-w-2xl mx-auto">
        <div class="relative shadow-xs rounded-2xl">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Busque por nome, partido ou UF (ex: Arthur Lira, SP, PT)..."
            autocomplete="off"
            class="w-full pl-11 pr-10 py-3.5 sm:py-4 text-sm sm:text-base rounded-2xl border border-slate-300 focus:border-emerald-600 focus:ring-3 focus:ring-emerald-600/15 transition outline-none bg-white text-slate-900 placeholder:text-slate-400 shadow-2xs"
          />
          <button 
            id="clearSearch" 
            type="button" 
            class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-600 transition"
            aria-label="Limpar busca"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Filtros Rápidos: Abas de Casa Legislativa + Selects Responsivos -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 mt-4 text-xs">
          <!-- Filtro por Casa (Todos / Câmara / Senado) -->
          <div class="w-full md:w-auto grid grid-cols-3 md:inline-flex rounded-xl md:rounded-lg border border-slate-200 bg-white p-1 md:p-0.5 shadow-2xs" id="casaFilterGroup">
            <button 
              type="button"
              data-filter-casa="" 
              class="casa-btn active px-2 sm:px-3 py-2 md:py-1.5 rounded-lg md:rounded-md font-semibold text-xs text-center transition bg-slate-900 text-white shadow-xs"
            >
              Todos ({totalParlamentares})
            </button>
            <button 
              type="button"
              data-filter-casa="camara" 
              class="casa-btn px-2 sm:px-3 py-2 md:py-1.5 rounded-lg md:rounded-md font-semibold text-xs text-center transition text-slate-600 hover:text-slate-900"
            >
              Câmara ({totalDeputados})
            </button>
            <button 
              type="button"
              data-filter-casa="senado" 
              class="casa-btn px-2 sm:px-3 py-2 md:py-1.5 rounded-lg md:rounded-md font-semibold text-xs text-center transition text-slate-600 hover:text-slate-900"
            >
              Senado ({totalSenadores})
            </button>
          </div>

          <!-- Selects de Eleições 2026, UF e Partido em container responsivo -->
          <div class="w-full md:w-auto flex flex-wrap md:flex-nowrap items-center gap-2">
            {mostrarTse && (
              <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 shadow-2xs w-full sm:w-auto justify-between sm:justify-start">
                <label for="filterEleicao" class="text-slate-500 font-medium whitespace-nowrap">2026:</label>
                <select id="filterEleicao" class="bg-transparent text-slate-700 outline-none focus:text-emerald-700 font-medium text-xs cursor-pointer flex-1 sm:flex-initial text-right sm:text-left">
                  <option value="">Todos</option>
                  <option value="candidatos">Candidatos ({totalCandidatos2026})</option>
                  <option value="reeleicao">Reeleição ({totalReeleicao2026})</option>
                </select>
              </div>
            )}

            <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 shadow-2xs flex-1 md:flex-initial justify-between md:justify-start">
              <label for="filterUf" class="text-slate-500 font-medium whitespace-nowrap">UF:</label>
              <select id="filterUf" class="bg-transparent text-slate-700 outline-none focus:text-emerald-700 text-xs cursor-pointer flex-1 md:flex-initial text-right md:text-left">
                <option value="">Todos os estados</option>
                {ufs.map(uf => <option value={uf.toLowerCase()}>{uf}</option>)}
              </select>
            </div>

            <!-- Filtro Multiselect de Partidos -->
            <div class="relative flex-1 md:flex-initial" id="partidoDropdownContainer">
              <button
                type="button"
                id="partidoDropdownBtn"
                class="w-full flex items-center justify-between md:justify-start gap-1.5 bg-white border border-slate-200 hover:border-slate-300 rounded-lg px-2.5 py-1.5 shadow-2xs text-xs text-slate-700 transition cursor-pointer"
                aria-expanded="false"
                aria-haspopup="true"
                aria-label="Filtrar por partido"
              >
                <div class="flex items-center gap-1.5 truncate">
                  <span class="text-slate-500 font-medium whitespace-nowrap">Partido:</span>
                  <span id="partidoLabel" class="font-medium text-slate-700 truncate max-w-[100px] sm:max-w-[130px]">Todos</span>
                </div>
                <div class="flex items-center gap-1 shrink-0 ml-1">
                  <span id="partidoCountBadge" class="hidden px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold leading-none"></span>
                  <svg id="partidoDropdownArrow" class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </button>

              <!-- Painel Flutuante do Multiselect -->
              <div
                id="partidoDropdownMenu"
                class="hidden absolute right-0 sm:right-0 md:left-0 md:right-auto top-full mt-1.5 w-60 sm:w-64 bg-white border border-slate-200 rounded-xl shadow-lg z-50 flex flex-col overflow-hidden text-xs"
              >
                <div class="px-3 py-2 border-b border-slate-100 flex items-center justify-between bg-slate-50/90">
                  <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide">Selecionar Partidos</span>
                  <button
                    type="button"
                    id="clearPartidosBtn"
                    class="text-[11px] text-emerald-700 hover:text-emerald-800 font-medium hover:underline cursor-pointer"
                  >
                    Limpar
                  </button>
                </div>
                <div class="overflow-y-auto max-h-56 p-1.5 space-y-0.5 divide-y divide-slate-50">
                  {partidos.map(p => (
                    <label class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg hover:bg-slate-50 cursor-pointer select-none text-slate-700 transition">
                      <input
                        type="checkbox"
                        name="partidoCheckbox"
                        value={p.toLowerCase()}
                        data-partido-name={p}
                        class="partido-checkbox rounded border-slate-300 text-emerald-600 focus:ring-emerald-600/20 w-3.5 h-3.5 cursor-pointer accent-emerald-600"
                      />
                      <span class="font-medium">{p}</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Lista de Parlamentares -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-slate-200 text-sm">
      <span class="text-slate-500 text-xs sm:text-sm">
        Mostrando <strong id="visibleCount" class="text-slate-900 font-semibold">{totalParlamentares}</strong> de {totalParlamentares} parlamentares
      </span>
      <div class="flex items-center gap-3">
        <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 shadow-2xs" id="viewToggleGroup">
          <button
            type="button"
            data-view="cards"
            class="view-btn active px-2.5 py-1 rounded-md font-semibold text-xs transition bg-slate-900 text-white"
          >
            Cards
          </button>
          <button
            type="button"
            data-view="lista"
            class="view-btn px-2.5 py-1 rounded-md font-semibold text-xs transition text-slate-600 hover:text-slate-900"
          >
            Lista
          </button>
        </div>
        <span class="text-slate-300 hidden sm:inline">•</span>
        <a href={`${base}votacoes`} class="text-emerald-700 hover:underline font-semibold text-xs sm:text-sm">
          Ver as {totalTemas} votações nominais →
        </a>
        <span class="text-slate-300 hidden sm:inline">•</span>
        <a href={`${base}criterios`} class="hidden sm:inline text-slate-500 hover:underline font-medium text-xs sm:text-sm">
          Critérios ↗
        </a>
      </div>
    </div>

    <!-- Grid de Cards -->
    <div id="parlamentaresGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-6">
      {parlamentares.map(p => (
        <div class="parlamentar-item">
          <ParlamentarCard parlamentar={p} />
        </div>
      ))}
    </div>

    <!-- Lista/Tabela ordenável -->
    <div id="parlamentaresTable" class="hidden pt-6 overflow-x-auto">
      <div class="min-w-[760px] flex flex-col gap-1.5">
        <div class:list={["grid gap-3 px-3.5 pb-1 text-[11px] font-semibold text-slate-500 uppercase tracking-wide", mostrarTse ? "grid-cols-[2fr_0.7fr_1.1fr_1.2fr_1.2fr_1.2fr]" : "grid-cols-[2fr_0.7fr_1.1fr_1.2fr_1.2fr]"]}>
          <button type="button" data-sort-key="nome" class="sort-btn text-left hover:text-slate-900 transition">
            Parlamentar <span class="sort-arrow"></span>
          </button>
          <span>Casa</span>
          <button type="button" data-sort-key="votos" class="sort-btn text-left hover:text-slate-900 transition" title="Presença de voto registrado nas votações cruciais catalogadas">
            Votações-Chave <span class="sort-arrow"></span>
          </button>
          <button type="button" data-sort-key="cota" class="sort-btn text-left hover:text-slate-900 transition">
            Gastos de Cota <span class="sort-arrow"></span>
          </button>
          <button type="button" data-sort-key="emendas" class="sort-btn text-left hover:text-slate-900 transition">
            Emendas Pagas <span class="sort-arrow"></span>
          </button>
          {mostrarTse && (
            <button type="button" data-sort-key="patrimonio" class="sort-btn text-left hover:text-slate-900 transition">
              Patrimônio <span class="sort-arrow"></span>
            </button>
          )}
        </div>
        <div id="parlamentaresTableBody" class="flex flex-col gap-1.5">
          {parlamentares.map(p => (
            <ParlamentarTableRow parlamentar={p} mostrarPatrimonio={mostrarTse} />
          ))}
        </div>
      </div>
      <p class="text-xs text-slate-400 pt-3 px-1 leading-relaxed">
        • <strong>Votações-Chave:</strong> indica a presença de voto registrado no painel eletrônico nas votações nominais catalogadas pela Ficha do Político (10 na Câmara e 9 no Senado). Não afere presença física diária em plenário nem sessões sem deliberação nominal. Suplentes e parlamentares licenciados para o Executivo podem apresentar menor total em razão do período em exercício.<br />
        • Valores ausentes ("—") indicam que a fonte oficial não tem registro para o parlamentar no período coberto — não significam gasto/emenda/patrimônio zero.
      </p>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden py-16 text-center space-y-3">
      <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto text-xl font-bold">
        ?
      </div>
      <h3 class="text-lg font-semibold text-slate-900">Nenhum parlamentar encontrado</h3>
      <p class="text-sm text-slate-500 max-w-sm mx-auto">
        Tente buscar com outra grafia, apenas o primeiro nome ou altere os filtros de Casa, UF ou Partido.
      </p>
    </div>
  </section>

  <!-- Script de Busca Client-Side Instantâneo com Debounce -->
  <script is:inline>
    const input = document.getElementById('searchInput');
    const clearBtn = document.getElementById('clearSearch');
    const filterEleicao = document.getElementById('filterEleicao');
    const filterUf = document.getElementById('filterUf');
    const partidoDropdownContainer = document.getElementById('partidoDropdownContainer');
    const partidoDropdownBtn = document.getElementById('partidoDropdownBtn');
    const partidoDropdownMenu = document.getElementById('partidoDropdownMenu');
    const partidoDropdownArrow = document.getElementById('partidoDropdownArrow');
    const partidoLabel = document.getElementById('partidoLabel');
    const partidoCountBadge = document.getElementById('partidoCountBadge');
    const clearPartidosBtn = document.getElementById('clearPartidosBtn');
    const partidoCheckboxes = Array.from(document.querySelectorAll('.partido-checkbox'));
    const casaBtns = Array.from(document.querySelectorAll('.casa-btn'));
    const grid = document.getElementById('parlamentaresGrid');
    const table = document.getElementById('parlamentaresTable');
    const tableBody = document.getElementById('parlamentaresTableBody');
    const cardItems = Array.from(grid.getElementsByClassName('parlamentar-item'));
    const rowItems = Array.from(tableBody.getElementsByClassName('parlamentar-row'));
    const visibleCount = document.getElementById('visibleCount');
    const emptyState = document.getElementById('emptyState');
    const viewBtns = Array.from(document.querySelectorAll('.view-btn'));
    const sortBtns = Array.from(document.querySelectorAll('.sort-btn'));

    function getAnchor(el) {
      return el.tagName === 'A' ? el : el.querySelector('a');
    }

    function getSelectedPartidos() {
      return partidoCheckboxes
        .filter(cb => cb.checked)
        .map(cb => cb.value);
    }

    function updatePartidoDisplay() {
      const checkedBoxes = partidoCheckboxes.filter(cb => cb.checked);
      const count = checkedBoxes.length;

      if (count === 0) {
        partidoLabel.textContent = 'Todos';
        partidoCountBadge.classList.add('hidden');
        partidoDropdownBtn.classList.remove('border-emerald-500', 'bg-emerald-50/40');
      } else if (count === 1) {
        const name = checkedBoxes[0].getAttribute('data-partido-name') || checkedBoxes[0].value.toUpperCase();
        partidoLabel.textContent = name;
        partidoCountBadge.classList.add('hidden');
        partidoDropdownBtn.classList.add('border-emerald-500', 'bg-emerald-50/40');
      } else if (count === 2) {
        const n1 = checkedBoxes[0].getAttribute('data-partido-name') || checkedBoxes[0].value.toUpperCase();
        const n2 = checkedBoxes[1].getAttribute('data-partido-name') || checkedBoxes[1].value.toUpperCase();
        partidoLabel.textContent = `${n1}, ${n2}`;
        partidoCountBadge.classList.add('hidden');
        partidoDropdownBtn.classList.add('border-emerald-500', 'bg-emerald-50/40');
      } else {
        partidoLabel.textContent = `${count} partidos`;
        partidoCountBadge.textContent = String(count);
        partidoCountBadge.classList.remove('hidden');
        partidoDropdownBtn.classList.add('border-emerald-500', 'bg-emerald-50/40');
      }
    }

    function matchesFilters(anchor, q, uf, selectedPartidos, eleicao) {
      const nome = anchor.getAttribute('data-nome') || '';
      const civil = anchor.getAttribute('data-civil') || '';
      const p = anchor.getAttribute('data-partido') || '';
      const u = anchor.getAttribute('data-uf') || '';
      const c = anchor.getAttribute('data-casa') || '';
      const isCand = anchor.getAttribute('data-candidato-2026') === 'true';
      const isReel = anchor.getAttribute('data-reeleicao') === 'true';

      const matchesQuery = !q || nome.includes(q) || civil.includes(q) || p.includes(q) || u.includes(q);
      const matchesUf = !uf || u === uf;
      const matchesPartido = selectedPartidos.length === 0 || selectedPartidos.includes(p);
      const matchesCasa = !activeCasa || c === activeCasa;
      let matchesEleicao = true;
      if (eleicao === 'candidatos') matchesEleicao = isCand;
      else if (eleicao === 'reeleicao') matchesEleicao = isReel;

      return matchesQuery && matchesUf && matchesPartido && matchesCasa && matchesEleicao;
    }

    let activeCasa = '';
    let debounceTimer = null;

    function renderFilter() {
      const q = input.value.trim().toLowerCase();
      const uf = filterUf.value;
      const selectedPartidos = getSelectedPartidos();
      const eleicao = filterEleicao ? filterEleicao.value : '';

      clearBtn.classList.toggle('hidden', q.length === 0);

      window.requestAnimationFrame(() => {
        let visible = 0;
        for (let i = 0; i < cardItems.length; i++) {
          const anchor = getAnchor(cardItems[i]);
          const ok = matchesFilters(anchor, q, uf, selectedPartidos, eleicao);
          cardItems[i].style.display = ok ? '' : 'none';
          if (ok) visible++;
        }
        for (let i = 0; i < rowItems.length; i++) {
          const anchor = getAnchor(rowItems[i]);
          const ok = matchesFilters(anchor, q, uf, selectedPartidos, eleicao);
          rowItems[i].style.display = ok ? '' : 'none';
        }

        visibleCount.textContent = visible;
        emptyState.classList.toggle('hidden', visible > 0);
      });
    }

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(renderFilter, 150);
    });

    if (filterEleicao) {
      filterEleicao.addEventListener('change', renderFilter);
    }
    filterUf.addEventListener('change', renderFilter);

    partidoCheckboxes.forEach(cb => {
      cb.addEventListener('change', () => {
        updatePartidoDisplay();
        renderFilter();
      });
    });

    if (clearPartidosBtn) {
      clearPartidosBtn.addEventListener('click', () => {
        partidoCheckboxes.forEach(cb => { cb.checked = false; });
        updatePartidoDisplay();
        renderFilter();
      });
    }

    function togglePartidoDropdown(open) {
      if (!partidoDropdownMenu) return;
      const shouldOpen = open !== undefined ? open : partidoDropdownMenu.classList.contains('hidden');
      if (shouldOpen) {
        partidoDropdownMenu.classList.remove('hidden');
        partidoDropdownArrow.classList.add('rotate-180');
        partidoDropdownBtn.setAttribute('aria-expanded', 'true');
      } else {
        partidoDropdownMenu.classList.add('hidden');
        partidoDropdownArrow.classList.remove('rotate-180');
        partidoDropdownBtn.setAttribute('aria-expanded', 'false');
      }
    }

    if (partidoDropdownBtn) {
      partidoDropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        togglePartidoDropdown();
      });
    }

    document.addEventListener('click', (e) => {
      if (partidoDropdownContainer && !partidoDropdownContainer.contains(e.target)) {
        togglePartidoDropdown(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        togglePartidoDropdown(false);
      }
    });

    casaBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        casaBtns.forEach(b => {
          b.classList.remove('active', 'bg-slate-900', 'text-white', 'shadow-xs');
          b.classList.add('text-slate-600');
        });
        btn.classList.add('active', 'bg-slate-900', 'text-white', 'shadow-xs');
        btn.classList.remove('text-slate-600');
        activeCasa = btn.getAttribute('data-filter-casa') || '';
        renderFilter();
      });
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      renderFilter();
      input.focus();
    });

    // Toggle de visualização (Cards / Lista)
    viewBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        viewBtns.forEach(b => {
          b.classList.remove('active', 'bg-slate-900', 'text-white');
          b.classList.add('text-slate-600');
        });
        btn.classList.add('active', 'bg-slate-900', 'text-white');
        btn.classList.remove('text-slate-600');

        const view = btn.getAttribute('data-view');
        grid.classList.toggle('hidden', view !== 'cards');
        table.classList.toggle('hidden', view !== 'lista');
      });
    });

    // Ordenação da tabela por coluna
    const DEFAULT_DIR = { nome: 'asc', votos: 'desc', cota: 'desc', emendas: 'desc', patrimonio: 'desc' };
    const ATTR_BY_KEY = { nome: 'data-nome', votos: 'data-votos', cota: 'data-cota', emendas: 'data-emendas', patrimonio: 'data-patrimonio' };
    let currentSort = { key: null, dir: null };

    function compareRows(a, b, key, dir) {
      const attr = ATTR_BY_KEY[key];
      if (key === 'nome') {
        const cmp = (a.getAttribute(attr) || '').localeCompare(b.getAttribute(attr) || '', 'pt-BR');
        return dir === 'asc' ? cmp : -cmp;
      }
      const rawA = parseFloat(a.getAttribute(attr));
      const rawB = parseFloat(b.getAttribute(attr));
      const aEmpty = Number.isNaN(rawA);
      const bEmpty = Number.isNaN(rawB);
      if (aEmpty && bEmpty) return 0;
      if (aEmpty) return 1;
      if (bEmpty) return -1;
      return dir === 'asc' ? rawA - rawB : rawB - rawA;
    }

    sortBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-sort-key');
        const dir = currentSort.key === key && currentSort.dir
          ? (currentSort.dir === 'asc' ? 'desc' : 'asc')
          : DEFAULT_DIR[key];
        currentSort = { key, dir };

        sortBtns.forEach(b => {
          b.querySelector('.sort-arrow').textContent = '';
        });
        btn.querySelector('.sort-arrow').textContent = dir === 'asc' ? '▲' : '▼';

        const sorted = rowItems.slice().sort((a, b) => compareRows(a, b, key, dir));
        sorted.forEach(row => tableBody.appendChild(row));
      });
    });
  </script>
</Layout>
